class SoftwareCompanyOrchestrator:
    """منسّق شركة البرمجيات: يدير الصوت، الاستدلال، الهجرة، الأداء، SBOM، الحاويات، والتشغيل المعزول."""

    def __init__(
        self,
        base_dir: Path = Path("./genesis_studio_data"),
        ollama_url: str = DEFAULT_OLLAMA_URL,
        auto_start_worker: bool = True,
    ):
        self.base_dir = Path(base_dir).resolve()
        self.projects_dir = self.base_dir / "projects"
        self.uploads_dir = self.base_dir / "uploads"
        self.projects_dir.mkdir(parents=True, exist_ok=True)
        self.uploads_dir.mkdir(parents=True, exist_ok=True)
        self.db_path = self.base_dir / "company.db"
        self.vault_db = self.base_dir / "shared_vault.db"
        self.ollama_url = ollama_url
        self._lock = threading.Lock()
        self._stop_event = threading.Event()
        self._init_db()
        self.governor = EcoResourceGovernor()
        self.sandbox = SandboxRunnerManager()
        self.watcher = FolderWatchScheduler(self, auto_start=auto_start_worker)
        self.voice_router = VoiceCommandRouter(self)
        if auto_start_worker:
            self._worker = threading.Thread(target=self._worker_loop, daemon=True)
            self._worker.start()

    def _connect(self):
        conn = sqlite3.connect(str(self.db_path), check_same_thread=False)
        conn.row_factory = sqlite3.Row
        return conn

    def _connect_vault(self):
        conn = sqlite3.connect(str(self.vault_db), check_same_thread=False)
        conn.row_factory = sqlite3.Row
        conn.execute(
            """CREATE TABLE IF NOT EXISTS engineering_vault (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                domain TEXT,
                pattern TEXT,
                verified_wisdom TEXT
            )"""
        )
        conn.commit()
        return conn

    def _init_db(self):
        with self._connect() as conn:
            conn.execute(
                """CREATE TABLE IF NOT EXISTS projects (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    title TEXT NOT NULL,
                    prompt TEXT NOT NULL,
                    mode TEXT NOT NULL DEFAULT 'new',
                    source_zip TEXT DEFAULT '',
                    status TEXT NOT NULL DEFAULT 'queued',
                    language TEXT DEFAULT 'Python',
                    score INTEGER DEFAULT 0,
                    tests_run INTEGER DEFAULT 0,
                    red_team_status TEXT DEFAULT 'pending',
                    workspace_path TEXT,
                    zip_path TEXT,
                    report_md TEXT DEFAULT '',
                    live_logs TEXT DEFAULT '',
                    overrides_json TEXT DEFAULT '{}',
                    created_at TEXT,
                    finished_at TEXT
                )"""
            )
            for col_sql in (
                "ALTER TABLE projects ADD COLUMN mode TEXT NOT NULL DEFAULT 'new'",
                "ALTER TABLE projects ADD COLUMN source_zip TEXT DEFAULT ''",
            ):
                try:
                    conn.execute(col_sql)
                except sqlite3.OperationalError:
                    pass
            conn.execute("UPDATE projects SET status = 'queued' WHERE status = 'running'")

    def submit_project(self, title: str, prompt: str, model_overrides: Optional[dict] = None) -> int:
        now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        clean_title = (title or prompt[:45]).strip()
        clean_overrides = {k: v for k, v in (model_overrides or {}).items() if v}
        with self._lock, self._connect() as conn:
            cur = conn.execute(
                """INSERT INTO projects (title, prompt, mode, status, overrides_json, created_at)
                   VALUES (?, ?, 'new', 'queued', ?, ?)""",
                (clean_title, prompt.strip(), json.dumps(clean_overrides, ensure_ascii=False), now),
            )
            return cur.lastrowid

    def submit_uploaded_zip(
        self,
        title: str,
        prompt: str,
        filename: str,
        zip_base64: str,
        model_overrides: Optional[dict] = None,
    ) -> int:
        if not zip_base64:
            raise ValueError("لم يتم إرفاق بيانات ملف ZIP.")
        try:
            zip_bytes = base64.b64decode(zip_base64, validate=True)
        except Exception as exc:
            raise ValueError("بيانات ملف ZIP المشفرة غير صالحة.") from exc

        safe_name = re.sub(r"[^a-zA-Z0-9_.-]", "_", Path(filename or "project.zip").name)
        if not safe_name.lower().endswith(".zip"):
            safe_name += ".zip"

        stamp = int(time.time() * 1000)
        saved_zip = self.uploads_dir / f"{stamp}_{safe_name}"
        extract_dir = self.uploads_dir / f"extracted_{stamp}"

        try:
            extracted_files = safe_extract_zip(zip_bytes, extract_dir)
            saved_zip.write_bytes(zip_bytes)
        except Exception:
            if extract_dir.exists():
                shutil.rmtree(extract_dir, ignore_errors=True)
            raise

        now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        clean_title = (title or f"تدقيق وترقيع: {Path(safe_name).stem}").strip()
        clean_prompt = (prompt or "فحص أمني شامل، إضافة اختبارات unittest، وترقيع كافة الثغرات.").strip()
        clean_overrides = {k: v for k, v in (model_overrides or {}).items() if v}
        init_log = f"📦 تم استلام وفك ضغط الأرشيف بنجاح ({len(extracted_files)} ملف).\n"

        with self._lock, self._connect() as conn:
            cur = conn.execute(
                """INSERT INTO projects
                   (title, prompt, mode, source_zip, status, live_logs, overrides_json, created_at)
                   VALUES (?, ?, 'audit', ?, 'queued', ?, ?, ?)""",
                (
                    clean_title,
                    clean_prompt,
                    str(extract_dir),
                    init_log,
                    json.dumps(clean_overrides, ensure_ascii=False),
                    now,
                ),
            )
            return cur.lastrowid

    def retry_project(self, project_id: int):
        self.sandbox.stop_project(project_id)
        with self._lock, self._connect() as conn:
            conn.execute(
                "UPDATE projects SET status = 'queued', live_logs = '', finished_at = NULL WHERE id = ?",
                (project_id,),
            )

    def delete_project(self, project_id: int) -> bool:
        self.sandbox.stop_project(project_id)
        proj = self.get_project(project_id)
        if not proj:
            return False
        with self._lock, self._connect() as conn:
            conn.execute("DELETE FROM projects WHERE id = ?", (project_id,))
        for path_key in ("workspace_path", "source_zip"):
            p = proj.get(path_key)
            if p and Path(p).exists():
                shutil.rmtree(p, ignore_errors=True)
        zp = proj.get("zip_path")
        if zp and Path(zp).exists():
            Path(zp).unlink(missing_ok=True)
        return True

    def list_projects(self) -> list:
        with self._connect() as conn:
            rows = conn.execute(
                """SELECT id, title, mode, status, language, score, tests_run, red_team_status, zip_path, created_at, finished_at
                   FROM projects ORDER BY id DESC"""
            ).fetchall()
            out = []
            for r in rows:
                d = dict(r)
                d["sandbox_running"] = self.sandbox.get_status(d["id"])["running"]
                out.append(d)
            return out

    def get_project(self, project_id: int) -> Optional[dict]:
        with self._connect() as conn:
            row = conn.execute("SELECT * FROM projects WHERE id = ?", (project_id,)).fetchone()
            if not row:
                return None
            data = dict(row)
            files = {}
            ws = data.get("workspace_path")
            if ws and Path(ws).exists():
                for f in sorted(Path(ws).rglob("*")):
                    if (
                        f.is_file()
                        and ".git" not in f.parts
                        and "__pycache__" not in f.parts
                        and "dist" not in f.parts
                        and not f.name.endswith(".db")
                    ):
                        rel = f.relative_to(ws).as_posix()
                        files[rel] = f.read_text(encoding="utf-8", errors="ignore")
            data["files"] = files
            data["has_swagger"] = "swagger_ui.html" in files
            data["has_frontend"] = "index.html" in files
            data["has_db"] = "db_layer.py" in files
            data["has_diagrams"] = "ARCHITECTURE.md" in files
            data["has_docker"] = "Dockerfile" in files and "docker-compose.yml" in files
            data["has_sbom"] = "sbom.json" in files
            data["sandbox"] = self.sandbox.get_status(project_id)

            if "BENCHMARK_REPORT.json" in files:
                try:
                    data["benchmark"] = json.loads(files["BENCHMARK_REPORT.json"])
                except Exception:
                    data["benchmark"] = None
            else:
                data["benchmark"] = None

            if "sbom.json" in files:
                try:
                    data["sbom"] = json.loads(files["sbom.json"])
                except Exception:
                    data["sbom"] = None
            else:
                data["sbom"] = None

            if ws and Path(ws).exists():
                data["diagrams"] = ArchitectureDiagramAgent.build_mermaid_sources(Path(ws), data["title"])
            else:
                data["diagrams"] = None

            baseline = data.get("source_zip")
            if baseline and ws and Path(baseline).exists() and Path(ws).exists():
                data["diffs"] = compute_project_diffs(Path(baseline), Path(ws))
            else:
                data["diffs"] = []
            return data

    def get_project_html_report(self, project_id: int) -> Optional[str]:
        proj = self.get_project(project_id)
