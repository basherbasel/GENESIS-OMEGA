            )

    def process_next_job(self) -> bool:
        next_job = None
        with self._lock, self._connect() as conn:
            row = conn.execute(
                """SELECT id, title, prompt, mode, source_zip, overrides_json
                   FROM projects WHERE status = 'queued' ORDER BY id ASC LIMIT 1"""
            ).fetchone()
            if row:
                next_job = dict(row)
                conn.execute("UPDATE projects SET status = 'running' WHERE id = ?", (next_job["id"],))

        if not next_job:
            return False

        pid = next_job["id"]
        ws = self.projects_dir / f"project_{pid}"
        try:
            gov_stats = self.governor.get_memory_stats()
            self._append_log(
                pid,
                f"⚡ حاكم الموارد (Eco-Governor): وضع={gov_stats['profile']} | الرام المتاحة={gov_stats['available_ram_gb']}GB/{gov_stats['total_ram_gb']}GB",
            )

            overrides = json.loads(next_job.get("overrides_json") or "{}")
            if next_job.get("mode") == "audit" and next_job.get("source_zip"):
                engine_inst = ExistingProjectAuditor(
                    workspace=ws,
                    vault_db=self.vault_db,
                    ollama_url=self.ollama_url,
                    model_overrides=overrides,
                )
                result = engine_inst.audit_and_upgrade(
                    source_dir=Path(next_job["source_zip"]),
                    goal=next_job["prompt"],
