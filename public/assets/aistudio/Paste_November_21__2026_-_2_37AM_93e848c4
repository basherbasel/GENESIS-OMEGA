import concurrent.futures
import json
import math
import statistics
import time
import urllib.request
from pathlib import Path
from typing import Optional

from omega_sandbox import SandboxRunnerManager


class PerformanceBenchmarkAgent:
    """يقيس سرعة الاستجابة (p50/p95/p99 ms) ومعدل الطلبات في الثانية (RPS) للمشاريع المبنية."""

    @staticmethod
    def _percentile(sorted_vals: list[float], pct: float) -> float:
        if not sorted_vals:
            return 0.0
        idx = min(len(sorted_vals) - 1, max(0, math.ceil((pct / 100.0) * len(sorted_vals)) - 1))
        return round(sorted_vals[idx], 2)

    @classmethod
    def run_benchmark(
        cls,
        workspace: Path,
        total_requests: int = 40,
        concurrency: int = 8,
    ) -> dict:
        workspace = Path(workspace).resolve()
        if not workspace.exists():
            raise ValueError("مساحة العمل غير موجودة لإجراء اختبار الأداء.")

        mgr = SandboxRunnerManager()
        bench_id = 999991
        latencies_ms: list[float] = []
        success_count = 0
        error_count = 0

        try:
            status = mgr.start_project(bench_id, workspace)
            base_url = status.get("url")
            if not status.get("running") or not base_url:
                return {
                    "status": "skipped",
                    "reason": "المشروع لا يحتوي على نقطة HTTP قابلة للقياس.",
                    "rps": 0.0,
                }

            target_url = f"{base_url}/"
            # تهيئة أولية (Warm-up)
            try:
                with urllib.request.urlopen(target_url, timeout=2.0):
                    pass
            except Exception:
                pass

            def _single_probe(_idx: int) -> tuple[bool, float]:
                t0 = time.perf_counter()
                try:
                    with urllib.request.urlopen(target_url, timeout=3.0) as resp:
                        _ = resp.read(256)
                        ok = 200 <= resp.status < 500
                except Exception:
                    ok = False
                dt_ms = (time.perf_counter() - t0) * 1000.0
                return ok, dt_ms

            t_start = time.perf_counter()
            with concurrent.futures.ThreadPoolExecutor(max_workers=concurrency) as pool:
                futures = [pool.submit(_single_probe, i) for i in range(total_requests)]
                for fut in concurrent.futures.as_completed(futures):
                    ok, dt = fut.result()
                    latencies_ms.append(dt)
                    if ok:
                        success_count += 1
                    else:
                        error_count += 1
            elapsed_sec = max(0.001, time.perf_counter() - t_start)

            latencies_ms.sort()
            rps = round(total_requests / elapsed_sec, 1)
            avg_ms = round(statistics.mean(latencies_ms), 2) if latencies_ms else 0.0
            p50_ms = cls._percentile(latencies_ms, 50)
            p95_ms = cls._percentile(latencies_ms, 95)
            p99_ms = cls._percentile(latencies_ms, 99)

            report = {
                "status": "completed",
                "total_requests": total_requests,
                "concurrency": concurrency,
                "success_count": success_count,
                "error_count": error_count,
                "rps": rps,
                "avg_latency_ms": avg_ms,
                "p50_latency_ms": p50_ms,
                "p95_latency_ms": p95_ms,
                "p99_latency_ms": p99_ms,
            }
            (workspace / "BENCHMARK_REPORT.json").write_text(
                json.dumps(report, ensure_ascii=False, indent=2),
                encoding="utf-8",
            )
            return report
        finally:
            mgr.stop_project(bench_id)
