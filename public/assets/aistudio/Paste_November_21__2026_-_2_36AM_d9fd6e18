                pid,
                f"⚡ حاكم الموارد (Eco-Governor): وضع={gov_stats['profile']} | الرام المتاحة={gov_stats['available_ram_gb']}GB/{gov_stats['total_ram_gb']}GB",
            )

            overrides = json.loads(next_job.get("overrides_json") or "{}")
            if next_job.get("mode") == "audit" and next_job.get("source_zip"):
                engine_inst = ExistingProjectAuditor(
                    workspace=ws,
                    vault_db=self.vault_db,
                    ollama_url=self.ollama_url,
                    model_overrides=overrides,
                )
                result = engine_inst.audit_and_upgrade(
                    source_dir=Path(next_job["source_zip"]),
                    goal=next_job["prompt"],
                    progress_cb=lambda msg: self._append_log(pid, msg),
                )
            else:
                engine_inst = GenesisOmegaEngine(
                    workspace=ws,
                    vault_db=self.vault_db,
                    ollama_url=self.ollama_url,
                    model_overrides=overrides,
                )
                eco_info = PolyglotEcosystemMatrix.detect_ecosystem(next_job["prompt"])
                reasoning = DeepReasoningEngine.synthesize_reasoning_brief(
                    prompt=next_job["prompt"],
                    ecosystem_info=eco_info,
                    ask_fn=engine_inst._ask,
                )
                self._append_log(pid, f"🧠 محرك الاستدلال العميق والتوقع الاستباقي:\n{reasoning['reasoning_brief']}")
                enriched_prompt = (
                    f"{next_job['prompt']}\n\n"
                    f"--- التوقعات الهندسية والاستدلال المعماري ---\n"
                    f"{reasoning['reasoning_brief']}"
                )
                result = engine_inst.run(enriched_prompt, progress_cb=lambda msg: self._append_log(pid, msg))

            # 1. وكيل قواعد البيانات SQLite والترحيلات الآلية
            db_msg = DatabaseMigrationAgent.generate_and_verify(
                workspace=ws,
                title=next_job["title"],
                prompt=next_job["prompt"],
                engine=engine_inst,
            )
            if db_msg:
                self._append_log(pid, db_msg)

            # 2. وكيل بناء الواجهة الأمامية واختبارات تكامل Full-Stack E2E
            fs_msg = FullStackAgent.generate_and_verify(
                workspace=ws,
                title=next_job["title"],
                prompt=next_job["prompt"],
                engine=engine_inst,
            )
            if fs_msg:
                self._append_log(pid, fs_msg)

            # 3. وكيل توثيق OpenAPI 3.0 وواجهة Swagger التفاعلية
            swagger_msg = ApiDocsAgent.generate_and_attach(
                workspace=ws,
                title=next_job["title"],
                prompt=next_job["prompt"],
                engine=engine_inst,
            )
            if swagger_msg:
                self._append_log(pid, swagger_msg)

            # 4. وكيل توثيق مخططات العمارة والبيانات (Mermaid ERD & Sequence Diagrams)
            diag_msg = ArchitectureDiagramAgent.generate_diagrams(
                workspace=ws,
                title=next_job["title"],
                prompt=next_job["prompt"],
            )
            if diag_msg:
                self._append_log(pid, diag_msg)

            # 5. وكيل حزمة التصدير والنشر عبر Docker (Dockerfile + docker-compose.yml)
            docker_msg = DockerPackagerAgent.generate_docker_bundle(
                workspace=ws,
                title=next_job["title"],
            )
            if docker_msg:
                self._append_log(pid, docker_msg)

            # 6. مصفوفة اللغات الشاملة ونظم التشغيل (Systemd + Multi-Language Docker)
            poly_res = PolyglotEcosystemMatrix.generate_multi_os_and_container_bundle(
                workspace=ws,
                title=next_job["title"],
                prompt=next_job["prompt"],
            )
            self._append_log(
                pid,
                f"🌐 تم تجهيز التوافق المتعدد لبيئة ({poly_res['display_name']}) وخدمة Linux ({poly_res['systemd_service']}).",
            )

            # 7. التغليف النهائي وإعادة إنشاء حزمة ZIP الشاملة بعد إضافة كل الملفات المولدة
            pack_logs = ProductionPackager.finalize_release(
                workspace=ws,
                title=next_job["title"],
                prompt=next_job["prompt"],
                result=result,
            )
            for pl in pack_logs:
                self._append_log(pid, pl)

            final_status = "verified" if result["verified"] else "needs_review"
            finished = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            with self._lock, self._connect() as conn:
                conn.execute(
                    """UPDATE projects
                       SET status = ?, language = ?, score = ?, tests_run = ?,
                           red_team_status = ?, workspace_path = ?, zip_path = ?,
                           report_md = ?, finished_at = ?
                       WHERE id = ?""",
                    (
                        final_status,
                        result["language"],
                        result["score"],
                        result["tests_run"],
                        result["red_team_status"],
                        result["workspace"],
                        result["zip_path"],
                        result["report"],
                        finished,
                        pid,
                    ),
                )

            full_proj = self.get_project(pid)
            if full_proj:
                HtmlAuditReportGenerator.generate_report(full_proj, workspace=ws)
                self._append_log(pid, "🖨️ تم توليد تقرير التدقيق الرسمي القابل للطباعة كـ PDF (OMEGA_AUDIT_REPORT.html).")

        except Exception as exc:
            self._append_log(pid, f"❌ خطأ حرج أثناء التنفيذ: {exc}")
            finished = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            with self._lock, self._connect() as conn:
                conn.execute(
                    "UPDATE projects SET status = 'failed', finished_at = ? WHERE id = ?",
                    (finished, pid),
                )
        return True

    def _worker_loop(self):
        while not self._stop_event.is_set():
            did_work = self.process_next_job()
            if not did_work:
                stats = self.governor.get_memory_stats()
                time.sleep(stats.get("watch_poll_sec", 2.0))

