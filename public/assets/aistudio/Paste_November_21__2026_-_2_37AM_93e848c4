import hashlib
import json
import re
from datetime import datetime, timezone
from pathlib import Path

SECRET_PATTERNS = [
    ("AWS Access Key", re.compile(r"AKIA[0-9A-Z]{16}")),
    ("GitHub Token", re.compile(r"gh[pousr]_[A-Za-z0-9_]{20,}")),
    ("Private Key Block", re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----")),
    ("Hardcoded Password/Secret", re.compile(r"""(?:api_key|secret_key|password|passwd|auth_token)\s*=\s*['"][^'"]{8,}['"]""", re.IGNORECASE)),
]


class SupplyChainSBOMGuardian:
    """يفحص تسريب المفاتيح والأسرار البرمجية ويولّد وثيقة SBOM معتمدة ببصمات SHA-256."""

    @classmethod
    def audit_and_generate_sbom(cls, workspace: Path, title: str = "omega-project") -> dict:
        workspace = Path(workspace).resolve()
        if not workspace.exists():
            return {"secrets_found": [], "components_count": 0}

        secrets_found: list[dict] = []
        components: list[dict] = []

        for f in sorted(workspace.rglob("*")):
            if not f.is_file():
                continue
            if any(part in (".git", "__pycache__", "node_modules") for part in f.parts):
                continue
            rel = f.relative_to(workspace).as_posix()
            raw = f.read_bytes()
            sha256 = hashlib.sha256(raw).hexdigest()
            components.append(
                {
                    "type": "file",
                    "name": rel,
                    "size_bytes": len(raw),
                    "hashes": [{"alg": "SHA-256", "content": sha256}],
                }
            )

            if f.suffix.lower() in {".py", ".js", ".ts", ".go", ".rs", ".java", ".php", ".env", ".yml", ".yaml", ".sh", ".ps1"}:
                txt = raw.decode("utf-8", errors="ignore")
                for label, rx in SECRET_PATTERNS:
                    if rx.search(txt):
                        secrets_found.append({"file": rel, "type": label})

        # قراءة الاعتماديات الخارجية من requirements.txt إن وجدت
        req_file = workspace / "requirements.txt"
        if req_file.exists():
            for line in req_file.read_text(encoding="utf-8", errors="ignore").splitlines():
                pkg = line.strip()
                if pkg and not pkg.startswith("#"):
                    components.append({"type": "library", "name": pkg, "ecosystem": "pypi"})

        sbom_doc = {
            "bomFormat": "CycloneDX",
            "specVersion": "1.5",
            "version": 1,
            "metadata": {
                "timestamp": datetime.now(timezone.utc).isoformat(),
                "component": {"name": title, "type": "application"},
                "tools": [{"name": "GENESIS-OMEGA SBOM Guardian", "version": "8.0"}],
            },
            "components": components,
            "security_audit": {
                "hardcoded_secrets_detected": len(secrets_found),
                "findings": secrets_found,
                "supply_chain_status": "clean" if not secrets_found else "warning",
            },
        }
        (workspace / "sbom.json").write_text(
            json.dumps(sbom_doc, ensure_ascii=False, indent=2),
            encoding="utf-8",
        )
        return {
            "secrets_found": secrets_found,
            "components_count": len(components),
            "supply_chain_status": sbom_doc["security_audit"]["supply_chain_status"],
        }
