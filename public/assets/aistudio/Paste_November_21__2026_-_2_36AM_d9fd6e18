function renderPipeline(logs, status, mode) {
  const stages = mode === 'audit'
    ? [{num:1,label:'1. الفحص الساكن'},{num:2,label:'2. تحليل الثغرات'},{num:3,label:'3. توليد الاختبارات'},{num:4,label:'4. Red-Team'},{num:5,label:'5. الترقيع الجراحي'},{num:6,label:'6. التغليف والتقارير'}]
    : [{num:1,label:'1. المعماري'},{num:2,label:'2. الاستراتيجي'},{num:3,label:'3. التنافس والتهجين'},{num:4,label:'4. Red-Team'},{num:5,label:'5. المداوي الجراحي'},{num:6,label:'6. DB & Docker & Docs'}];
  let currentStage = 0;
  for (let i = 1; i <= 6; i++) if ((logs || '').includes(`[${i}/6]`)) currentStage = i;
  const finished = ['verified', 'needs_review', 'failed'].includes(status);
  return '<div class="pipeline">' + stages.map(s => {
    let cls = '';
    if (finished && status !== 'failed') cls = 'done';
    else if (s.num < currentStage) cls = 'done';
    else if (s.num === currentStage) cls = 'active';
    return `<div class="stage-box ${cls}">${s.label}</div>`;
  }).join('') + '</div>';
}

function renderDiffViewer(diffs) {
  if (!diffs || !diffs.length) return '<p style="color:var(--muted)">لا توجد فروقات مسجلة.</p>';
  return diffs.map(d => {
    const linesHtml = (d.diff_text || '').split('\n').map(line => {
      let cls = 'd-ctx';
      if (line.startsWith('+++') || line.startsWith('---') || line.startsWith('@@')) cls = 'd-hunk';
      else if (line.startsWith('+')) cls = 'd-add';
      else if (line.startsWith('-')) cls = 'd-del';
      return `<span class="d-line ${cls}">${escHtml(line)}</span>`;
    }).join('');
    return `<div class="diff-card"><div class="diff-hdr"><span><strong>${escHtml(d.file)}</strong> (${escHtml(d.status)})</span><span><span class="diff-stat-add">+${d.added}</span><span class="diff-stat-del">-${d.removed}</span></span></div><pre class="diff-body">${linesHtml}</pre></div>`;
  }).join('');
}

