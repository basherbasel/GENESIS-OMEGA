<script>
let selectedId = null;
let activeTab = 'logs';
let workMode = 'new';
let selectedZipFile = null;
let templatesCache = [];
let recognition = null;
let isListening = false;
const ROLES = ['architect','strategist','builder_alpha','builder_beta','red_team','synthesizer_healer'];

function escHtml(s) {
  return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function speakArabic(text) {
  if (!document.getElementById('ttsToggle')?.checked) return;
  if (!('speechSynthesis' in window) || !text) return;
  try {
    window.speechSynthesis.cancel();
    const utt = new SpeechSynthesisUtterance(text);
    utt.lang = 'ar-EG';
    utt.rate = 1.05;
    window.speechSynthesis.speak(utt);
  } catch (e) {}
}

function toggleVoiceRecognition() {
  const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SpeechRec) {
    alert('المتصفح الحالي لا يدعم التعرف الصوتي المباشر، يمكنك كتابة أمرك في شريط الأوامر بالأعلى.');
    return;
  }
  const btn = document.getElementById('micBtn');
  if (isListening && recognition) {
    recognition.stop();
    return;
  }
  recognition = new SpeechRec();
  recognition.lang = 'ar-EG';
  recognition.interimResults = false;
  recognition.maxAlternatives = 1;

  recognition.onstart = () => {
    isListening = true;
    btn.classList.add('listening');
    btn.textContent = '🔴 جاري الاستماع... انقر للإيقاف';
  };
  recognition.onresult = async (event) => {
    const transcript = event.results[0][0].transcript;
    document.getElementById('voiceCmdInput').value = transcript;
    await sendVoiceCommand();
  };
  recognition.onerror = () => {
    isListening = false;
    btn.classList.remove('listening');
    btn.textContent = '🎙️ تحدث بأمرك';
  };
  recognition.onend = () => {
    isListening = false;
    btn.classList.remove('listening');
    btn.textContent = '🎙️ تحدث بأمرك';
  };
  recognition.start();
}

async function sendVoiceCommand() {
  const inp = document.getElementById('voiceCmdInput');
  const transcript = inp.value.trim();
  if (!transcript) return;
  const replyBox = document.getElementById('voiceReplyBox');
  replyBox.style.display = 'block';
  replyBox.textContent = '⏳ جاري تحليل وتنفيذ الأمر الصوتي...';

  const res = await fetch('/api/voice/command', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({transcript, active_project_id: selectedId})
  });
  const data = await res.json();
  replyBox.textContent = `🤖 ${data.spoken_reply || ''}`;
  speakArabic(data.spoken_reply || '');

  const cmd = data.ui_command;
  if (cmd) {
    if (cmd.action === 'switch_view') switchTopView(cmd.view);
    if (cmd.action === 'select_project' && cmd.project_id) {
      switchTopView('studio');
      selectedId = cmd.project_id;
      if (cmd.tab) activeTab = cmd.tab;
      if (cmd.open_url) window.open(cmd.open_url, '_blank');
    }
  }
  await refreshAll();
}

function switchTopView(view) {
  document.getElementById('viewStudio').style.display = view === 'studio' ? 'grid' : 'none';
  document.getElementById('viewWatch').style.display = view === 'watch' ? 'block' : 'none';
  document.getElementById('viewVault').style.display = view === 'vault' ? 'block' : 'none';
  document.getElementById('navStudio').classList.toggle('active', view === 'studio');
  document.getElementById('navWatch').classList.toggle('active', view === 'watch');
  document.getElementById('navVault').classList.toggle('active', view === 'vault');
  if (view === 'watch') loadWatches();
  if (view === 'vault') loadAnalytics();
}

async function startSandbox(id) {
  const res = await fetch(`/api/projects/${id}/sandbox/start`, {method: 'POST'});
  const data = await res.json();
  if (!res.ok) return alert(data.error || 'تعذر تشغيل البيئة المعزولة');
  activeTab = 'sandbox';
  await refreshAll();
}

async function stopSandbox(id) {
  await fetch(`/api/projects/${id}/sandbox/stop`, {method: 'POST'});
  await refreshAll();
}

async function loadWatches() {
  const res = await fetch('/api/watches');
  const items = await res.json();
  const box = document.getElementById('watchList');
  if (!items.length) {
    box.innerHTML = '<p style="color:var(--muted)">لا توجد مجلدات مراقبة حالياً.</p>';
    return;
  }
  box.innerHTML = items.map(w => `
    <div class="list-card">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
        <strong style="direction:ltr;font-family:Consolas,monospace;color:var(--cyan)">${escHtml(w.folder_path)}</strong>
        <div style="display:flex;gap:6px;align-items:center">
          <span class="status ${w.enabled ? 'st-verified' : 'st-queued'}">${w.enabled ? 'نشط' : 'متوقف'}</span>
          <button class="secondary" onclick="toggleWatch(${w.id})">${w.enabled ? 'إيقاف مؤقت' : 'تفعيل'}</button>
          <button class="danger" onclick="deleteWatch(${w.id})">حذف</button>
        </div>
      </div>
      <div style="font-size:0.83rem;margin-top:6px">${escHtml(w.goal)}</div>
      <div style="font-size:0.77rem;color:var(--muted);margin-top:6px">
        الفترة: كل ${w.interval_sec} ثانية | الملفات: ${w.files_count} | آخر فحص: ${w.last_checked_at || '-'}
      </div>
    </div>
  `).join('');
}

async function addWatchFolder() {
  const folder_path = document.getElementById('wFolderPath').value;
  const interval_sec = parseInt(document.getElementById('wInterval').value || '15', 10);
  const goal = document.getElementById('wGoal').value;
  const msgEl = document.getElementById('watchMsg');
  const res = await fetch('/api/watches', {
    method: 'POST', headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({folder_path, interval_sec, goal})
  });
  const data = await res.json();
  if (!res.ok) {
    msgEl.innerHTML = `<span style="color:var(--err)">❌ ${escHtml(data.error)}</span>`;
    return;
  }
  msgEl.innerHTML = '<span style="color:var(--ok)">✅ تم تسجيل المجلد وتعيين البصمة الأساسية بنجاح.</span>';
  document.getElementById('wFolderPath').value = '';
  await loadWatches();
}

async function toggleWatch(id) { await fetch(`/api/watches/${id}/toggle`, {method: 'POST'}); await loadWatches(); }
async function deleteWatch(id) { await fetch(`/api/watches/${id}`, {method: 'DELETE'}); await loadWatches(); }
async function triggerWatchScanNow() {
  const res = await fetch('/api/watches/scan', {method: 'POST'});
  const data = await res.json();
  alert(`اكتمل الفحص الفوري: تم إطلاق ${(data.triggered || []).length} مهمة تدقيق.`);
  await loadWatches();
  await refreshAll();
}

function openExportModal() {
  if (!selectedId) return;
  document.getElementById('exportStatus').innerHTML = '';
  document.getElementById('exportModal').style.display = 'flex';
}
function closeExportModal() { document.getElementById('exportModal').style.display = 'none'; }
function setExportTab(tab) {
  document.getElementById('expTabLocal').classList.toggle('active', tab === 'local');
  document.getElementById('expTabGit').classList.toggle('active', tab === 'git');
  document.getElementById('expLocalPane').style.display = tab === 'local' ? 'block' : 'none';
  document.getElementById('expGitPane').style.display = tab === 'git' ? 'block' : 'none';
}

async function runLocalExport() {
  const destination = document.getElementById('expLocalPath').value;
  const st = document.getElementById('exportStatus');
  st.innerHTML = '<span style="color:var(--cyan)">جاري نسخ الملفات...</span>';
  const res = await fetch(`/api/projects/${selectedId}/export/local`, {
    method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({destination})
  });
  const data = await res.json();
  st.innerHTML = res.ok ? `<span style="color:var(--ok)">✅ ${escHtml(data.message)}</span>` : `<span style="color:var(--err)">❌ ${escHtml(data.error)}</span>`;
}

async function runGitPush() {
  const repo_url = document.getElementById('expGitUrl').value;
  const branch = document.getElementById('expGitBranch').value;
  const token = document.getElementById('expGitToken').value;
  const commit_message = document.getElementById('expGitMsg').value;
  const st = document.getElementById('exportStatus');
  st.innerHTML = '<span style="color:var(--cyan)">جاري تهيئة Git ورفع المشروع...</span>';
  const res = await fetch(`/api/projects/${selectedId}/export/git`, {
    method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({repo_url, branch, token, commit_message})
  });
  const data = await res.json();
  st.innerHTML = res.ok ? `<span style="color:var(--ok)">✅ ${escHtml(data.message)}</span>` : `<span style="color:var(--err)">❌ ${escHtml(data.error)}</span>`;
}

async function loadAnalytics() {
  const q = encodeURIComponent(document.getElementById('vSearch')?.value || '');
  const res = await fetch(`/api/analytics?q=${q}`);
  const data = await res.json();
  const k = data.kpis || {};
  document.getElementById('kpiGrid').innerHTML = `
    <div class="kpi-box"><div class="kpi-val">${k.total_projects || 0}</div><div class="kpi-lbl">إجمالي المشاريع</div></div>
    <div class="kpi-box"><div class="kpi-val" style="color:var(--ok)">${k.success_rate || 0}%</div><div class="kpi-lbl">نسبة التحقق الكامل</div></div>
    <div class="kpi-box"><div class="kpi-val">${k.avg_score || 0}</div><div class="kpi-lbl">متوسط النقاط الهندسية</div></div>
    <div class="kpi-box"><div class="kpi-val" style="color:#d8b4fe">${k.total_tests || 0}</div><div class="kpi-lbl">إجمالي الاختبارات المنفذة</div></div>
    <div class="kpi-box"><div class="kpi-val" style="color:var(--warn)">${k.vault_entries || 0}</div><div class="kpi-lbl">خبرات الخزينة المحفوظة</div></div>
  `;
  const vList = document.getElementById('vaultList');
  if (!data.vault || !data.vault.length) {
    vList.innerHTML = '<p style="color:var(--muted)">لا توجد خبرات مطابقة بعد.</p>';
    return;
  }
  vList.innerHTML = data.vault.map(v => `
    <div class="list-card">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <span class="mode-tag">${escHtml(v.domain)}</span>
        <button class="danger" onclick="deleteVaultRule(${v.id})">حذف</button>
      </div>
      <div style="font-weight:700;margin-top:6px;font-size:0.9rem">${escHtml(v.pattern)}</div>
      <div style="color:var(--muted);font-size:0.84rem;margin-top:4px">${escHtml(v.verified_wisdom)}</div>
    </div>
  `).join('');
}

async function addVaultRule() {
  const domain = document.getElementById('vDomain').value;
  const pattern = document.getElementById('vPattern').value;
  const wisdom = document.getElementById('vWisdom').value;
  const res = await fetch('/api/vault', {
    method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({domain, pattern, wisdom})
  });
  if (!res.ok) return alert('يرجى ملء النمط والقاعدة الهندسية');
  document.getElementById('vDomain').value = ''; document.getElementById('vPattern').value = ''; document.getElementById('vWisdom').value = '';
  await loadAnalytics();
}

async function deleteVaultRule(id) { await fetch(`/api/vault/${id}`, {method: 'DELETE'}); await loadAnalytics(); }

function setWorkMode(mode) {
  workMode = mode;
  document.getElementById('btnModeNew').classList.toggle('active', mode === 'new');
  document.getElementById('btnModeAudit').classList.toggle('active', mode === 'audit');
  document.getElementById('panelNew').style.display = mode === 'new' ? 'block' : 'none';
  document.getElementById('panelAudit').style.display = mode === 'audit' ? 'block' : 'none';
  document.getElementById('submitBtn').textContent =
    mode === 'new' ? 'إرسال إلى خط الإنتاج' : 'رفع الأرشيف وبدء التدقيق والترقيع';
}

function handleZipSelected(file) {
  if (!file) return;
  if (!file.name.toLowerCase().endsWith('.zip')) return alert('يرجى اختيار ملف بصيغة .zip فقط');
  selectedZipFile = file;
  document.getElementById('zipLabel').textContent = `✅ جاهز للرفع: ${file.name} (${Math.round(file.size / 1024)} KB)`;
}

const dz = document.getElementById('dropZone');
dz.addEventListener('dragover', e => { e.preventDefault(); dz.classList.add('dragover'); });
dz.addEventListener('dragleave', () => dz.classList.remove('dragover'));
dz.addEventListener('drop', e => { e.preventDefault(); dz.classList.remove('dragover'); if (e.dataTransfer.files?.[0]) handleZipSelected(e.dataTransfer.files[0]); });

function fileToBase64(file) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => { const res = reader.result || ''; const idx = res.indexOf(','); resolve(idx !== -1 ? res.slice(idx + 1) : ''); };
    reader.onerror = () => reject(reader.error);
    reader.readAsDataURL(file);
  });
}

function collectOverrides() {
  const overrides = {};
  ROLES.forEach(r => { const val = document.getElementById('m_' + r).value; if (val) overrides[r] = val; });
  return overrides;
}

async function initDashboard() {
  const [stRes, tplRes, ecoRes] = await Promise.all([
    fetch('/api/status'),
    fetch('/api/templates'),
    fetch('/api/ecosystems'),
  ]);
  const status = await stRes.json();
  templatesCache = await tplRes.json();
  const ecosystems = await ecoRes.json();

  const ecoSel = document.getElementById('ecoSelect');
  Object.entries(ecosystems).forEach(([k, v]) => {
    const opt = document.createElement('option');
    opt.value = k;
    opt.textContent = `${v.display_name} — [${v.category}]`;
    ecoSel.appendChild(opt);
  });

  const tplSel = document.getElementById('tplSelect');
  templatesCache.forEach(t => {
    const opt = document.createElement('option'); opt.value = t.id; opt.textContent = t.name; tplSel.appendChild(opt);
  });

  const models = (status.ollama_models || []).map(m => m.name);
  const routing = status.active_routing || {};
  ROLES.forEach(role => {
    const sel = document.getElementById('m_' + role);
    const defOpt = document.createElement('option'); defOpt.value = ''; defOpt.textContent = `تلقائي (${routing[role] || 'افتراضي'})`; sel.appendChild(defOpt);
    models.forEach(mName => { const o = document.createElement('option'); o.value = mName; o.textContent = mName; sel.appendChild(o); });
  });

  const gov = status.governor || {};
  document.getElementById('sysBadge').textContent =
    `RAM متاحة: ${gov.available_ram_gb || status.ram_gb}GB | وضع: ${gov.profile || 'eco'} | التوليد: ${routing.builder_alpha || '-'}`;
}

function applyTemplate() {
  const found = templatesCache.find(t => t.id === document.getElementById('tplSelect').value);
  if (!found) return;
  document.getElementById('pTitle').value = found.title;
  document.getElementById('pPrompt').value = found.prompt;
}

async function handleSubmit() {
  const overrides = collectOverrides();
  if (workMode === 'new') {
    const title = document.getElementById('pTitle').value;
    const rawPrompt = document.getElementById('pPrompt').value;
    const ecoKey = document.getElementById('ecoSelect').value;
    if (!rawPrompt.trim()) return alert('يرجى كتابة وصف المشروع');
    const prompt = ecoKey && ecoKey !== 'python' ? `[Target Ecosystem: ${ecoKey}] ${rawPrompt}` : rawPrompt;
    const res = await fetch('/api/projects', {
      method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({title, prompt, overrides})
    });
    const data = await res.json();
    document.getElementById('pTitle').value = ''; document.getElementById('pPrompt').value = ''; document.getElementById('tplSelect').value = '';
    selectedId = data.id;
    await refreshAll();
  } else {
    if (!selectedZipFile) return alert('يرجى اختيار ملف مشروع بصيغة .zip أولاً');
    const title = document.getElementById('aTitle').value;
    const prompt = document.getElementById('aPrompt').value;
    const btn = document.getElementById('submitBtn');
    btn.disabled = true; btn.textContent = 'جاري رفع وفك ضغط الأرشيف...';
    try {
      const zip_base64 = await fileToBase64(selectedZipFile);
      const res = await fetch('/api/projects/upload', {
        method: 'POST', headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({title, prompt, filename: selectedZipFile.name, zip_base64, overrides})
      });
      const data = await res.json();
      if (!res.ok) return alert(data.error || 'فشل رفع الأرشيف');
      selectedZipFile = null; document.getElementById('zipInput').value = '';
      document.getElementById('zipLabel').textContent = '📦 اسحب ملف المشروع (.zip) هنا أو انقر للاختيار';
      document.getElementById('aTitle').value = ''; document.getElementById('aPrompt').value = '';
      selectedId = data.id;
      await refreshAll();
    } finally { btn.disabled = false; setWorkMode('audit'); }
  }
}

