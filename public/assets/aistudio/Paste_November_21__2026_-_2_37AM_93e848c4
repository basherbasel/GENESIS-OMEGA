                engine=engine_inst,
            )
            if fs_msg:
                self._append_log(pid, fs_msg)

            # 3. وكيل توثيق OpenAPI 3.0 وواجهة Swagger التفاعلية
            swagger_msg = ApiDocsAgent.generate_and_attach(
