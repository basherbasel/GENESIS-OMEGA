        return predictions[:6]

    @classmethod
    def synthesize_reasoning_brief(
        cls,
        prompt: str,
        ecosystem_info: dict,
        vault_context: str = "",
        ask_fn=None,
    ) -> dict:
        """يبني ملخص التفكير الاستدلالي والتوقعات الاستباقية لتوجيه المعماري والمطورين."""
        eco_name = ecosystem_info.get("display_name", "Python")
        predicted_reqs = cls.predict_implicit_requirements(prompt, eco_name)

        reasoning_steps = [
            f"1. [تحديد البيئة المستهدفة]: {eco_name} ({ecosystem_info.get('category', 'Modern')})",
            f"2. [التوقعات الهندسية الاستباقية]: {' | '.join(predicted_reqs[:3])}",
            "3. [ضمان الأمان والأداء]: عزل المدخلات، تجنب الدوال الخطرة، وضمان العمل الخفيف على الموارد.",
        ]

        llm_synthesis = ""
        if callable(ask_fn):
            try:
                raw = ask_fn(
                    "strategist",
                    """أنت محرك استدلال معماري خفيف. في 4 نقاط مركزة وموجزة جداً (أقل من 120 كلمة):
1) استنتج الحالات الحدية الخفية في طلب المستخدم.
2) حدد أخطر ثغرة أمنية محتملة وكيفية منعها.
3) اقترح البنية الأنسب للأداء العالي واستهلاك الذاكرة المنخفض.""",
                    f"الطلب: {prompt}\nالبيئة: {eco_name}\nالتوقعات الأولية: {predicted_reqs}\nالخبرات السابقة:\n{vault_context[:900]}",
                    temp=0.15,
                )
                llm_synthesis = strip_think_tags(raw)[:900]
            except Exception:
                llm_synthesis = ""

        brief_text = "\n".join(reasoning_steps)
        if llm_synthesis:
            brief_text += f"\n\n[استنتاج الاستدلال العميق]:\n{llm_synthesis}"

        return {
            "ecosystem": eco_name,
            "predicted_requirements": predicted_reqs,
            "reasoning_brief": brief_text,
        }

