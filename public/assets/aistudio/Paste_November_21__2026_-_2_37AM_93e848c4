import json
import re
import sqlite3
from datetime import datetime
from pathlib import Path
from typing import Optional

from omega_core import strip_think_tags
from omega_polyglot_matrix import PolyglotEcosystemMatrix


class CognitivePersonaEngine:
    """
    محرك الوعي الإدراكي والشخصية البشرية الحية:
    - يفهم طريقة تفكير المستخدم ونبرته العاطفية والتقنية.
    - يتذكر تفضيلاته عبر الجلسات في ذاكرة طويلة المدى (user_cognition.db).
    - يدير الحوار التفاعلي متعدد الأدوار ويقترح الخطوة التالية بذكاء.
    """

    def __init__(self, orchestrator, db_path: Optional[Path] = None):
        self.orch = orchestrator
        self.db_path = Path(db_path) if db_path else (orchestrator.base_dir / "user_cognition.db")
        self.db_path.parent.mkdir(parents=True, exist_ok=True)
        self._pending_suggestion: Optional[dict] = None
        self._init_db()

    def _connect(self):
        conn = sqlite3.connect(str(self.db_path), check_same_thread=False)
        conn.row_factory = sqlite3.Row
        return conn

    def _init_db(self):
        with self._connect() as conn:
            conn.execute(
                """CREATE TABLE IF NOT EXISTS user_traits (
                    trait_key TEXT PRIMARY KEY,
                    trait_value TEXT NOT NULL,
                    confidence INTEGER DEFAULT 1,
                    updated_at TEXT
                )"""
            )
            conn.execute(
                """CREATE TABLE IF NOT EXISTS dialogue_history (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    role TEXT NOT NULL,
                    content TEXT NOT NULL,
                    thinking_style TEXT DEFAULT 'balanced',
                    emotion TEXT DEFAULT 'calm',
                    created_at TEXT
                )"""
            )
            conn.commit()

    def _upsert_trait(self, key: str, value: str):
        now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        with self._connect() as conn:
            conn.execute(
                """INSERT INTO user_traits (trait_key, trait_value, confidence, updated_at)
                   VALUES (?, ?, 1, ?)
                   ON CONFLICT(trait_key) DO UPDATE SET
                     trait_value = excluded.trait_value,
                     confidence = user_traits.confidence + 1,
                     updated_at = excluded.updated_at""",
                (key, value, now),
            )
            conn.commit()

    def _log_turn(self, role: str, content: str, style: str = "balanced", emotion: str = "calm"):
        now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        with self._connect() as conn:
            conn.execute(
                """INSERT INTO dialogue_history (role, content, thinking_style, emotion, created_at)
                   VALUES (?, ?, ?, ?, ?)""",
                (role, content[:1500], style, emotion, now),
            )
            conn.commit()

    def get_user_cognitive_profile(self) -> dict:
        with self._connect() as conn:
            traits = {r["trait_key"]: r["trait_value"] for r in conn.execute("SELECT * FROM user_traits").fetchall()}
            recent = [
                dict(r)
                for r in conn.execute(
                    "SELECT role, content, thinking_style, emotion FROM dialogue_history ORDER BY id DESC LIMIT 8"
                ).fetchall()
            ]
        recent.reverse()
        return {"traits": traits, "recent_dialogue": recent}

    def analyze_mindset_and_emotion(self, text: str) -> dict:
        """يحلل أسلوب تفكير المستخدم والحالة الشعورية من صياغة كلامه."""
        low = text.lower()

        # 1. استخراج التفضيلات الدائمة تلقائياً
        if any(w in low for w in ("بدون إنترنت", "اوفلاين", "أوفلاين", "محلي", "offline", "local")):
            self._upsert_trait("deployment_preference", "يفضل العمل المحلي المستقل بدون إنترنت (Offline-First)")
        if any(w in low for w in ("خفيف", "رام", "سريع", "بدون تعقيد", "zero-bloat", "lightweight")):
            self._upsert_trait("architecture_style", "يفضل البنية الخفيفة عالية الكفاءة قليلة استهلاك الذاكرة")
        if any(w in low for w in ("أمان", "ثغرات", "حماية", "تشفير", "security", "hardened")):
            self._upsert_trait("priority_focus", "يعطي أولوية قصوى للأمان السيبراني وتحصين الكود")

        # 2. تحديد أسلوب التفكير اللحظي
        if any(w in low for w in ("معمارية", "تصميم", "تخطيط", "خارطة", "رؤية", "نظام متكامل", "هيكل")):
            thinking_style = "architectural_visionary"
        elif any(w in low for w in ("بسرعة", "فوراً", "دلوقتي", "حالاً", "يلا", "ابدأ", "نفذ")):
            thinking_style = "action_executor"
        elif any(w in low for w in ("ليه", "إزاي", "كيف", "اشرح", "فهمني", "رأيك", "تفكر", "مقارنة")):
            thinking_style = "analytical_explorer"
        else:
            thinking_style = "collaborative_builder"

        # 3. تحديد النبرة الشعورية لضبط إيقاع الصوت (Prosody)
        if any(w in low for w in ("مشكلة", "خطأ", "عطل", "باظ", "مش شغال", "بطيء", "قلقان", "تعبني")):
            emotion = "empathetic_focused"
            prosody = {"rate": 0.98, "pitch": 0.96}
        elif any(w in low for w in ("ممتاز", "عاش", "رائع", "حلو", "تمام", "جميل", "برافو")):
            emotion = "warm_enthusiastic"
            prosody = {"rate": 1.06, "pitch": 1.05}
        elif any(w in low for w in ("مستعجل", "بسرعة", "فوراً", "أنجز")):
            emotion = "crisp_energetic"
            prosody = {"rate": 1.12, "pitch": 1.02}
        else:
            emotion = "calm_human"
            prosody = {"rate": 1.02, "pitch": 1.0}

        return {
            "thinking_style": thinking_style,
            "emotion": emotion,
            "prosody": prosody,
        }

    def _is_affirmation(self, text: str) -> bool:
        clean = re.sub(r"[؟?!.,،]", "", text.strip().lower())
        return clean in {
            "نعم", "أيوه", "ايوه", "اه", "آه", "تمام", "موافق", "ماشي", "يلا", "يلا بينا",
            "نفذ", "اعمل كده", "توكل على الله", "أكيد", "اكيد", "بالضبط", "yes", "ok", "do it",
        }

    def _synthesize_human_dialogue(self, user_text: str, mindset: dict, active_pid: Optional[int]) -> dict:
        """يولّد رداً بشرياً طبيعياً يفهم سياق المستخدم ويستنتج الإجراء المناسب."""
        profile = self.get_user_cognitive_profile()
