{
  "name": "genesis-omega",
  "private": true,
  "version": "1.0.0",
  "description": "Voice-controlled autonomous software engineering studio with local Ollama synthesis, real OS verification and self-healing agents.",
  "author": "Bashar",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "tsx --test src/lib/*.test.ts src/lib/brains/*.test.ts src/lib/brains/dependency_graph.test.ts src/lib/enterprise/*.test.ts src/lib/enterprise/peer_review_and_precision.test.ts src/lib/runtime/*.test.ts src/lib/security/*.test.ts src/lib/voice/*.test.ts",
    "test:piper": "tsx --test src/lib/piper_tts.test.ts",
    "test:omega": "tsx --test src/lib/omega.test.ts",
    "test:healer": "tsx --test src/lib/healer.test.ts",
    "test:deploy": "tsx --test src/lib/git_deploy.test.ts",
    "test:auth": "tsx --test src/lib/auth.test.ts",
    "test:e2e": "playwright test",
    "doctor": "tsx scripts/doctor.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "check": "npm run lint && npm test && npm run check:secrets && npm run doctor",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
