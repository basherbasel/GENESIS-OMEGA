### 1. حاكم الموارد الذكي للأجهزة الضعيفة والمتوسطة: `omega_governor.py`

احفظ هذا الملف في مجلد المشروع بجانب `omega_core.py`:

```python
import ctypes
import os
import platform
import subprocess
from pathlib import Path


class EcoResourceGovernor:
    """يراقب الذاكرة والمعالج بدون مكتبات ثقيلة ويضبط استهلاك النماذج لحماية الأجهزة الضعيفة."""

    @staticmethod
    def get_memory_stats() -> dict:
        sys_name = platform.system().lower()
        total_bytes = 0
        avail_bytes = 0

        try:
            if sys_name == "windows":
                class MEMORYSTATUSEX(ctypes.Structure):
                    _fields_ = [
                        ("dwLength", ctypes.c_ulong),
                        ("dwMemoryLoad", ctypes.c_ulong),
                        ("ullTotalPhys", ctypes.c_ulonglong),
                        ("ullAvailPhys", ctypes.c_ulonglong),
                        ("ullTotalPageFile", ctypes.c_ulonglong),
                        ("ullAvailPageFile", ctypes.c_ulonglong),
                        ("ullTotalVirtual", ctypes.c_ulonglong),
                        ("ullAvailVirtual", ctypes.c_ulonglong),
                        ("sullAvailExtendedVirtual", ctypes.c_ulonglong),
                    ]

                stat = MEMORYSTATUSEX()
                stat.dwLength = ctypes.sizeof(MEMORYSTATUSEX)
                ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(stat))
                total_bytes = int(stat.ullTotalPhys)
                avail_bytes = int(stat.ullAvailPhys)
            elif Path("/proc/meminfo").exists():
                info = {}
                for line in Path("/proc/meminfo").read_text(encoding="utf-8", errors="ignore").splitlines():
                    parts = line.split(":")
                    if len(parts) == 2:
                        val_kb = int(parts[1].strip().split()[0])
                        info[parts[0].strip()] = val_kb * 1024
                total_bytes = info.get("MemTotal", 0)
                avail_bytes = info.get("MemAvailable", info.get("MemFree", 0))
            elif sys_name == "darwin":
                out = subprocess.check_output(["sysctl", "-n", "hw.memsize"], text=True).strip()
                total_bytes = int(out)
                avail_bytes = int(total_bytes * 0.45)
        except Exception:
            total_bytes = 8 * (1024 ** 3)
            avail_bytes = 3 * (1024 ** 3)

        total_gb = round(total_bytes / (1024 ** 3), 2) if total_bytes else 8.0
        avail_gb = round(avail_bytes / (1024 ** 3), 2) if avail_bytes else 3.0
        used_pct = round(((total_gb - avail_gb) / total_gb) * 100, 1) if total_gb > 0 else 50.0
        cpu_cores = os.cpu_count() or 4

        if total_gb <= 8.5 or avail_gb < 2.5:
            profile = "eco_ultra_light"
            num_ctx = 4096
            keep_alive = "30s"
            max_prompt_chars = 4200
            watch_poll_sec = 4.0
        elif total_gb <= 18.0:
            profile = "balanced_light"
            num_ctx = 6144
            keep_alive = "45s"
            max_prompt_chars = 6000
            watch_poll_sec = 2.5
        else:
            profile = "performance"
            num_ctx = 8192
            keep_alive = "120s"
            max_prompt_chars = 8500
            watch_poll_sec = 1.5

        safe_threads = max(2, min(cpu_cores - 1, 6)) if profile != "performance" else max(4, cpu_cores - 2)

        return {
            "os": platform.system(),
            "cpu_cores": cpu_cores,
            "total_ram_gb": total_gb,
            "available_ram_gb": avail_gb,
            "ram_used_pct": used_pct,
            "profile": profile,
            "ollama_tuning": {
                "num_ctx": num_ctx,
                "num_thread": safe_threads,
                "keep_alive": keep_alive,
            },
            "max_prompt_chars": max_prompt_chars,
            "watch_poll_sec": watch_poll_sec,
        }

