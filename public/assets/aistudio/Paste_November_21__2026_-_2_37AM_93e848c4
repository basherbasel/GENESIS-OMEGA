def safe_extract_zip(zip_bytes: bytes, dest_dir: Path) -> list:
    if len(zip_bytes) > MAX_ZIP_BYTES:
        raise ValueError("حجم ملف ZIP يتجاوز الحد الأقصى المسموح (25MB).")

    dest_dir = Path(dest_dir).resolve()
    dest_dir.mkdir(parents=True, exist_ok=True)
    extracted = []
    total_unpacked = 0

    with zipfile.ZipFile(io.BytesIO(zip_bytes), "r") as zf:
        members = [m for m in zf.infolist() if not m.is_dir()]
        if not members:
            raise ValueError("ملف ZIP فارغ ولا يحتوي على أي ملفات.")
        if len(members) > MAX_ZIP_FILES:
            raise ValueError(f"عدد الملفات داخل الأرشيف يتجاوز الحد المسموح ({MAX_ZIP_FILES}).")

        split_parts = [Path(m.filename).parts for m in members if m.filename.strip()]
        top_roots = {p[0] for p in split_parts if len(p) > 1}
        has_root_files = any(len(p) == 1 for p in split_parts)
        strip_prefix = list(top_roots)[0] if (len(top_roots) == 1 and not has_root_files) else None

        for info in members:
            raw_parts = Path(info.filename).parts
            if strip_prefix and raw_parts and raw_parts[0] == strip_prefix:
                raw_parts = raw_parts[1:]
            if not raw_parts:
                continue

            if any(p in PolyglotToolchain.IGNORED_DIRS or p.startswith(".") for p in raw_parts):
                continue

            rel_posix = "/".join(raw_parts)
            target = is_safe_relative_path(dest_dir, rel_posix)
            if not target:
                raise ValueError(f"تم رفض مسار غير آمن داخل الأرشيف: {info.filename}")

            total_unpacked += info.file_size
            if total_unpacked > MAX_UNPACKED_BYTES:
                raise ValueError("الحجم الإجمالي بعد فك الضغط يتجاوز الحد الآمن (60MB).")

            target.parent.mkdir(parents=True, exist_ok=True)
            with zf.open(info, "r") as src_fp:
                target.write_bytes(src_fp.read())
            extracted.append(rel_posix)

    if not extracted:
        raise ValueError("لم يتم العثور على ملفات برمجية صالحة داخل الأرشيف.")
    return extracted


def compute_project_diffs(baseline_dir: Path, final_dir: Path) -> list:
    if not baseline_dir or not final_dir or not baseline_dir.exists() or not final_dir.exists():
        return []

    def _collect(root: Path) -> dict:
        out = {}
        for f in sorted(root.rglob("*")):
            if not f.is_file():
                continue
            rel_parts = f.relative_to(root).parts
            if any(p in PolyglotToolchain.IGNORED_DIRS or p.startswith(".") for p in rel_parts):
                continue
            if f.name in DIFF_IGNORED_FILES or f.name.endswith(".db"):
                continue
            rel = f.relative_to(root).as_posix()
            out[rel] = f.read_text(encoding="utf-8", errors="ignore")
        return out

    old_files = _collect(baseline_dir)
    new_files = _collect(final_dir)
    all_paths = sorted(set(old_files.keys()) | set(new_files.keys()))
    diffs = []

    for rel in all_paths:
        old_txt = old_files.get(rel)
        new_txt = new_files.get(rel)
        if old_txt == new_txt:
            continue

        old_lines = (old_txt or "").splitlines()
        new_lines = (new_txt or "").splitlines()
        raw_diff = list(
            difflib.unified_diff(
                old_lines,
                new_lines,
                fromfile=f"a/{rel}" if old_txt is not None else "/dev/null",
                tofile=f"b/{rel}" if new_txt is not None else "/dev/null",
                lineterm="",
            )
        )
        added = sum(1 for ln in raw_diff if ln.startswith("+") and not ln.startswith("+++"))
        removed = sum(1 for ln in raw_diff if ln.startswith("-") and not ln.startswith("---"))
        status = "added" if old_txt is None else ("removed" if new_txt is None else "modified")
        diffs.append(
            {
                "file": rel,
                "status": status,
                "added": added,
                "removed": removed,
                "diff_text": "\n".join(raw_diff),
            }
        )
    return diffs


class ExistingProjectAuditor(GenesisOmegaEngine):
