class PolyglotEcosystemMatrix:
    """يدير بناء وتغليف المشاريع عبر جميع لغات البرمجة القديمة والحديثة ونظم التشغيل والحاويات."""

    @classmethod
    def detect_ecosystem(cls, prompt: str, workspace: Optional[Path] = None) -> dict:
        if workspace and Path(workspace).exists():
            ws = Path(workspace)
            ext_map = {
                ".go": "go",
                ".rs": "rust",
                ".cpp": "cpp",
                ".cc": "cpp",
                ".c": "c",
                ".cs": "csharp",
                ".java": "java",
                ".ts": "typescript",
                ".js": "nodejs",
                ".php": "php",
                ".rb": "ruby",
                ".pas": "pascal",
                ".f90": "fortran",
                ".cob": "cobol",
                ".lua": "lua",
                ".dart": "flutter",
                ".ps1": "powershell",
            }
            for f in ws.iterdir():
                if f.is_file() and f.suffix.lower() in ext_map:
                    key = ext_map[f.suffix.lower()]
                    return {"key": key, **ECOSYSTEM_CATALOG[key]}

        low = f" {(prompt or '').lower()} "
        for key, meta in ECOSYSTEM_CATALOG.items():
            if key == "python":
                continue
            if any(kw in low for kw in meta["keywords"]):
                return {"key": key, **meta}

        return {"key": "python", **ECOSYSTEM_CATALOG["python"]}

    @classmethod
    def generate_multi_os_and_container_bundle(
        cls,
        workspace: Path,
        title: str,
        prompt: str,
        ecosystem: Optional[dict] = None,
    ) -> dict:
        """يولّد ملفات التشغيل لـ Linux/Windows وخدمة systemd و Dockerfile مخصص للغة المشروع."""
        workspace = Path(workspace).resolve()
        workspace.mkdir(parents=True, exist_ok=True)
        eco = ecosystem or cls.detect_ecosystem(prompt, workspace)
        key = eco["key"]

        slug = re.sub(r"[^a-z0-9-]+", "-", title.lower()).strip("-") or "genesis-omega-service"
        if not slug[0].isalpha():
            slug = f"svc-{slug}"

        # 1. توليد ملف خدمة Linux systemd للإنتاج
        deploy_dir = workspace / "deploy"
        deploy_dir.mkdir(exist_ok=True)
        systemd_unit = (
            f"[Unit]\n"
            f"Description={title} (Built by GENESIS-OMEGA)\n"
            f"After=network.target\n\n"
            f"[Service]\n"
            f"Type=simple\n"
            f"WorkingDirectory=/opt/{slug}\n"
            f"ExecStart=/bin/bash /opt/{slug}/run.sh\n"
            f"Restart=always\n"
            f"RestartSec=5\n"
            f"User=omegauser\n\n"
            f"[Install]\n"
            f"WantedBy=multi-user.target\n"
        )
        (deploy_dir / f"{slug}.service").write_text(systemd_unit, encoding="utf-8")

        # 2. تحديث/توليد Dockerfile مخصص للغات غير Python (إذا لم يكن Python)
        if key != "python":
            extra_install = ""
            if key == "cobol":
                extra_install = "RUN apt-get update && apt-get install -y --no-install-recommends gnucobol && rm -rf /var/lib/apt/lists/*\n"
            elif key == "pascal":
                extra_install = "RUN apt-get update && apt-get install -y --no-install-recommends fp-compiler && rm -rf /var/lib/apt/lists/*\n"

            build_step = f"RUN {eco['build_cmd']}\n" if eco["build_cmd"] != "none" else ""
            dockerfile = (
                f"# Universal Polyglot Container ({eco['display_name']})\n"
                f"FROM {eco['base_image']}\n\n"
                "WORKDIR /app\n"
                f"{extra_install}"
                "COPY . .\n"
                f"{build_step}"
                "EXPOSE 8000\n"
                f"{eco['docker_cmd']}\n"
            )
            (workspace / "Dockerfile").write_text(dockerfile, encoding="utf-8")

        return {
            "ecosystem_key": key,
            "display_name": eco["display_name"],
            "systemd_service": f"deploy/{slug}.service",
        }

