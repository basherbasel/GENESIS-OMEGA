### 7. اختبارات التحقق الشاملة لإصدار Neon 5 v7.0: `test_genesis_v7.py`

احفظ هذا الملف وشغّله للتحقق الفوري من التحكم الصوتي، الاستدلال العميق، اللغات المتعددة، وحاكم الموارد الخفيف:

```python
import json
import os
import tempfile
import threading
import unittest
import urllib.request
from http.server import ThreadingHTTPServer
from pathlib import Path
from unittest import mock

from omega_company import SoftwareCompanyOrchestrator
from omega_governor import EcoResourceGovernor
from omega_polyglot_matrix import PolyglotEcosystemMatrix
from omega_reasoner import DeepReasoningEngine
from omega_web import make_handler
from test_genesis_studio import _MockOllamaHandler


class TestGenesisOmegaV7(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.mock_server = ThreadingHTTPServer(("127.0.0.1", 0), _MockOllamaHandler)
        cls.mock_port = cls.mock_server.server_address[1]
        cls.mock_url = f"http://127.0.0.1:{cls.mock_port}"
        cls.srv_thread = threading.Thread(target=cls.mock_server.serve_forever, daemon=True)
        cls.srv_thread.start()

    @classmethod
    def tearDownClass(cls):
        cls.mock_server.shutdown()
        cls.mock_server.server_close()

    def test_01_eco_resource_governor_lightweight_tuning(self):
        stats = EcoResourceGovernor.get_memory_stats()
        self.assertGreater(stats["total_ram_gb"], 0)
        self.assertIn(stats["profile"], ("eco_ultra_light", "balanced_light", "performance"))
        self.assertIn("num_ctx", stats["ollama_tuning"])
        self.assertIn("keep_alive", stats["ollama_tuning"])

    def test_02_deep_reasoning_and_predictive_requirements(self):
        eco = PolyglotEcosystemMatrix.detect_ecosystem("ابنِ خادم REST API للمبيعات مع قاعدة بيانات")
        res = DeepReasoningEngine.synthesize_reasoning_brief(
            prompt="ابنِ خادم REST API للمبيعات مع قاعدة بيانات",
            ecosystem_info=eco,
        )
        self.assertGreaterEqual(len(res["predicted_requirements"]), 3)
        self.assertIn("WAL", res["reasoning_brief"])

    def test_03_polyglot_matrix_modern_and_legacy_containers(self):
        with tempfile.TemporaryDirectory() as tmp:
            root = Path(tmp)
            # اختبار لغة قديمة (COBOL) ولغة نظم حديثة (Rust)
            cobol_eco = PolyglotEcosystemMatrix.detect_ecosystem("نظام بنكي بلغة cobol")
            self.assertEqual(cobol_eco["key"], "cobol")
            PolyglotEcosystemMatrix.generate_multi_os_and_container_bundle(
                root / "cobol_app", "Bank Mainframe", "cobol", cobol_eco
            )
            self.assertIn("gnucobol", (root / "cobol_app" / "Dockerfile").read_text(encoding="utf-8"))
            self.assertTrue((root / "cobol_app" / "deploy" / "bank-mainframe.service").exists())

            rust_eco = PolyglotEcosystemMatrix.detect_ecosystem("أداة سريعة بلغة rust")
            self.assertEqual(rust_eco["key"], "rust")
            PolyglotEcosystemMatrix.generate_multi_os_and_container_bundle(
                root / "rust_app", "Fast CLI", "rust", rust_eco
            )
            self.assertIn("rust:1.77-slim", (root / "rust_app" / "Dockerfile").read_text(encoding="utf-8"))

    def test_04_voice_command_control_end_to_end(self):
        with tempfile.TemporaryDirectory() as tmp, mock.patch.dict(os.environ, {"OMEGA_GIT": "0"}):
            orch = SoftwareCompanyOrchestrator(
                base_dir=Path(tmp) / "studio",
                ollama_url=self.mock_url,
                auto_start_worker=False,
            )
            web_srv = ThreadingHTTPServer(("127.0.0.1", 0), make_handler(orch, self.mock_url))
            web_port = web_srv.server_address[1]
            t = threading.Thread(target=web_srv.serve_forever, daemon=True)
            t.start()

            try:
                # 1. أمر صوتي لإنشاء مشروع
                req_build = urllib.request.Request(
                    f"http://127.0.0.1:{web_port}/api/voice/command",
                    data=json.dumps({"transcript": "ابني تطبيق Full-Stack للمهام"}).encode("utf-8"),
                    headers={"Content-Type": "application/json"},
                    method="POST",
                )
                with urllib.request.urlopen(req_build) as resp:
                    voice_res = json.loads(resp.read().decode("utf-8"))
                    self.assertEqual(voice_res["intent"], "create_project")
                    pid = voice_res["project_id"]
                    self.assertIn("تم استلام أمرك", voice_res["spoken_reply"])

                # تنفيذ خط الإنتاج
                self.assertTrue(orch.process_next_job())

                # 2. أمر صوتي لتشغيل المشروع في البيئة المعزولة
                req_run = urllib.request.Request(
                    f"http://127.0.0.1:{web_port}/api/voice/command",
                    data=json.dumps({"transcript": f"شغل المشروع رقم {pid}"}).encode("utf-8"),
                    headers={"Content-Type": "application/json"},
                    method="POST",
                )
                with urllib.request.urlopen(req_run) as resp:
                    run_res = json.loads(resp.read().decode("utf-8"))
                    self.assertEqual(run_res["intent"], "start_sandbox")
                    self.assertTrue(run_res["data"]["running"])

                # 3. أمر صوتي لإيقاف البيئة المعزولة
                req_stop = urllib.request.Request(
                    f"http://127.0.0.1:{web_port}/api/voice/command",
                    data=json.dumps({"transcript": f"أوقف المشروع رقم {pid}"}).encode("utf-8"),
                    headers={"Content-Type": "application/json"},
                    method="POST",
                )
                with urllib.request.urlopen(req_stop) as resp:
                    stop_res = json.loads(resp.read().decode("utf-8"))
                    self.assertEqual(stop_res["intent"], "stop_sandbox")
                    self.assertFalse(stop_res["data"]["running"])

                # 4. أمر صوتي للاستعلام عن حالة النظام والذاكرة
                req_st = urllib.request.Request(
                    f"http://127.0.0.1:{web_port}/api/voice/command",
                    data=json.dumps({"transcript": "ما حالة النظام والذاكرة؟"}).encode("utf-8"),
                    headers={"Content-Type": "application/json"},
                    method="POST",
                )
                with urllib.request.urlopen(req_st) as resp:
                    st_res = json.loads(resp.read().decode("utf-8"))
                    self.assertEqual(st_res["intent"], "system_status")
                    self.assertIn("جيجابايت", st_res["spoken_reply"])
            finally:
                orch.sandbox.stop_all()
                web_srv.shutdown()
                web_srv.server_close()


if __name__ == "__main__":
    unittest.main(verbosity=2)

