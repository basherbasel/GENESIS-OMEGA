                f"طلب المستخدم: {audit_goal}\nملاحظات الفحص الساكن: {initial_sec}\nالكود:\n{self._dump_arena(work_arena, 5500)}",
                temp=0.2,
            )
        )[:2400]

        log("🧬 [3/6] توليد وتعزيز اختبارات unittest والتحقق من خط الأساس...")
        test_cmd = f'"{sys.executable}" -m unittest discover -v'
        has_tests = any(Path(f).name.startswith("test_") for f in code_files)

        test_gen_raw = self._ask(
            "builder_alpha",
            """أنت مهندس جودة برمجيات. اكتب ملف اختبارات Python باسم `test_omega_audit.py` يغطي دوال المشروع والحالات الحدية.
أخرج الملف بالصيغة التالية حصراً:
===FILE: test_omega_audit.py===
```python
كود الاختبارات الكامل هنا
```""",
            f"طلب التدقيق: {audit_goal}\nالتحليل الأمني:\n{constraints}\n\nملفات المشروع:\n{self._dump_arena(work_arena, 5500)}",
            temp=0.15,
        )
        gen_bundle = parse_files_bundle(test_gen_raw)
        if not gen_bundle and not has_tests:
            m_code = re.search(r"```(?:python)?\n(.*?)```", strip_think_tags(test_gen_raw), re.DOTALL)
            if m_code:
                gen_bundle["test_omega_audit.py"] = m_code.group(1).strip() + "\n"
        self._write_bundle_safe(work_arena, gen_bundle)

        current_eval = PolyglotToolchain.build_and_verify(work_arena, "none", test_cmd)
        log(
            f"   📊 التقييم الأساسي -> نقاط={current_eval['score']} | اختبارات={current_eval['tests_run']} | ملاحظات أمنية={len(current_eval['security_issues'])}"
        )

        log("🎯 [4/6] الهجوم العدائي (Red-Team Fuzzing) لاختبار صمود المشروع...")
        modules = [
            f.stem
            for f in work_arena.glob("*.py")
            if not f.name.startswith("test_") and not f.name.startswith("red_team_")
        ]
        attack_raw = self._ask(
            "red_team",
            """اكتب سكربت Python باسم red_team_attack.py يستورد دوال المشروع ويهاجمها بمدخلات خبيثة وحدية.
