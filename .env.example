# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Gemini model overrides (verified IDs; leave empty to use the pinned defaults).
OMEGA_MODEL_GEMINI_DEFAULT=""
OMEGA_MODEL_GEMINI_FLASH=""
OMEGA_MODEL_GEMINI_FLASH_LITE=""
OMEGA_MODEL_GEMINI_BALANCED=""
OMEGA_MODEL_GEMINI_DEEP=""
OMEGA_MODEL_GEMINI_TTS=""
OMEGA_MODEL_GEMINI_TRANSCRIBE=""

# OLLAMA_HOST: base URL of the local Ollama runtime used for offline coding models.
# Catalog of 34 lightweight/quantized coding models is exposed at GET /api/models.
OLLAMA_HOST="http://127.0.0.1:11434"

# OMEGA_LOCAL_FIRST=1: route every agent role to the best installed local model.
OMEGA_LOCAL_FIRST="0"

# OMEGA_ALLOW_MODEL_PULL=1: allow POST /api/models/pull to download a curated tag.
OMEGA_ALLOW_MODEL_PULL="0"

# Optional: local Piper neural TTS (offline Arabic voice, no API key needed).
# OMEGA_PIPER_BIN points to piper.exe / piper.cmd; OMEGA_PIPER_MODEL to an Arabic .onnx.
# When omitted, the server auto-discovers them on PATH, in models/piper/, voices/,
# piper_models/, and E:/piper/.
OMEGA_PIPER_BIN=""
OMEGA_PIPER_MODEL=""

# Rate limit for /api/projects, /api/voice/* and /api/solutions/generate.
OMEGA_RATE_LIMIT_MAX="120"
OMEGA_RATE_LIMIT_WINDOW_MS="60000"

# Optional: bind the HTTP server to a specific interface. Default 127.0.0.1.
HOST="127.0.0.1"

# Optional: enable session authentication for every /api/* and /sandbox/* route.
# When set, the UI shows a login screen; the key is exchanged for an HttpOnly cookie.
OMEGA_API_KEY=""
# Set to 1 when serving over HTTPS (adds the Secure flag to the session cookie).
OMEGA_COOKIE_SECURE="0"

# Optional: allow local bare-repository paths as Git deploy remotes (tests/on-prem).
OMEGA_ALLOW_LOCAL_GIT_REMOTE="0"
