class VoiceCommandRouter:
    """يحوّل الأوامر الصوتية باللغة العربية والإنجليزية إلى أفعال برمجية وتشغيلية حقيقية."""

    WAKE_WORDS_RE = re.compile(
        r"^(?:يا\s+جينيسيس|يا\s+جنيسيس|يا\s+أوميجا|يا\s+اوميجا|جينيسيس|أوميجا|genesis|omega)[،,:\s-]*",
        re.IGNORECASE,
    )

    def __init__(self, orchestrator):
        self.orch = orchestrator

    @staticmethod
    def _extract_project_id(text: str) -> Optional[int]:
        m = re.search(r"(?:رقم|مشروع|#)\s*(\d+)", text)
        if m:
            return int(m.group(1))
        m2 = re.search(r"\b(\d+)\b", text)
        return int(m2.group(1)) if m2 else None

    def execute_voice_command(self, transcript: str, active_project_id: Optional[int] = None) -> dict:
        raw_cmd = (transcript or "").strip()
        cmd = self.WAKE_WORDS_RE.sub("", raw_cmd).strip()
        if not cmd:
            return {
                "intent": "wake_ack",
                "spoken_reply": "نعم، أنا جاهز. تفضل بإصدار أمرك البرمجي أو التشغيلي.",
                "ui_command": None,
            }

        low = cmd.lower()
        target_pid = self._extract_project_id(cmd) or active_project_id
        if not target_pid:
            projects = self.orch.list_projects()
            if projects:
                target_pid = projects[0]["id"]

        # 1. إيقاف البيئة المعزولة
        if any(k in low for k in ("أوقف", "اوقف", "إيقاف", "ايقاف", "اقفل", "stop sandbox", "stop server")):
            if not target_pid:
                return {"intent": "stop_sandbox", "spoken_reply": "لا يوجد مشروع نشط لإيقافه حالياً.", "ui_command": None}
            st = self.orch.stop_project_sandbox(target_pid)
            return {
                "intent": "stop_sandbox",
                "project_id": target_pid,
                "spoken_reply": f"تم إيقاف البيئة المعزولة للمشروع رقم {target_pid} وتحرير المنفذ بنجاح.",
                "ui_command": {"action": "select_project", "project_id": target_pid, "tab": "sandbox"},
                "data": st,
            }

        # 2. تشغيل البيئة المعزولة
