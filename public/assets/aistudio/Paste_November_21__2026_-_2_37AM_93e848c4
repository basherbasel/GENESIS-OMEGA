import hashlib
import os
import re
import shutil
import subprocess
from pathlib import Path
from typing import Optional


class PiperNeuralVoiceEngine:
    """
    محرك نطق صوتي عصبي محلي (Offline Neural TTS) يعتمد على Piper عند توفره
    مع تخزين مؤقت ببصمة SHA-256 وضبط إيقاع السرعة حسب النبرة (prosody).
    """

    DEFAULT_MODEL_DIRS = [
        Path("./models/piper"),
        Path("./piper_models"),
        Path("./voices"),
        Path.home() / ".local/share/piper",
        Path("E:/piper"),
    ]

    def __init__(self, cache_dir: Optional[Path] = None):
        self.cache_dir = Path(cache_dir) if cache_dir else Path("./genesis_studio_data/voice_cache")
        self.cache_dir.mkdir(parents=True, exist_ok=True)
        self.piper_bin = self._discover_piper_binary()
        self.model_path = self._discover_arabic_model()

    def _discover_piper_binary(self) -> Optional[str]:
        env_bin = os.environ.get("OMEGA_PIPER_BIN", "").strip()
        if env_bin and Path(env_bin).exists():
            return str(Path(env_bin).resolve())

        for candidate in ("piper", "piper.exe"):
            found = shutil.which(candidate)
            if found:
                return found

        local_candidates = [
            Path("./piper/piper.exe"),
            Path("./piper/piper"),
            Path("./tools/piper/piper.exe"),
            Path("./tools/piper/piper"),
        ]
        for p in local_candidates:
            if p.exists() and p.is_file():
                return str(p.resolve())
        return None

    def _discover_arabic_model(self) -> Optional[str]:
        env_model = os.environ.get("OMEGA_PIPER_MODEL", "").strip()
        if env_model and Path(env_model).exists():
            return str(Path(env_model).resolve())

        search_roots = [Path("."), *self.DEFAULT_MODEL_DIRS]
        onnx_files: list[Path] = []
        for root in search_roots:
            if not root.exists():
                continue
            for f in root.rglob("*.onnx"):
                if f.is_file():
                    onnx_files.append(f)

        # تفضيل النماذج العربية أولاً
        for f in onnx_files:
            name_low = f.name.lower()
            if any(k in name_low for k in ("ar", "arabic", "kareem", "salma", "shakir")):
                return str(f.resolve())

        return str(onnx_files[0].resolve()) if onnx_files else None

    def status(self) -> dict:
        ready = bool(self.piper_bin and self.model_path)
        return {
            "piper_binary_found": bool(self.piper_bin),
            "piper_binary": self.piper_bin or "",
            "arabic_model_found": bool(self.model_path),
            "model_path": self.model_path or "",
            "offline_neural_ready": ready,
            "cache_dir": str(self.cache_dir.resolve()),
        }

    @staticmethod
    def _clean_for_speech(text: str) -> str:
        cleaned = re.sub(r"[`*_#~>\[\]]+", " ", text or "")
        cleaned = re.sub(r"\s+", " ", cleaned).strip()
        return cleaned

    @staticmethod
    def _rate_to_length_scale(rate: float) -> float:
        # في Piper: قيمة أقل تعني نطقاً أسرع، وقيمة أعلى تعني نطقاً أبطأ وهدوءاً
        safe_rate = max(0.75, min(1.35, float(rate or 1.02)))
        scale = 1.0 / safe_rate
        return round(max(0.72, min(1.30, scale)), 2)

    def synthesize_wav(self, text: str, prosody: Optional[dict] = None) -> Optional[Path]:
        """
        يولّد ملف WAV محلياً عبر Piper ويعيد مساره، أو يعيد None إذا لم يكن Piper/النموذج متاحاً.
        """
        spoken = self._clean_for_speech(text)
        if not spoken:
            return None

        # إعادة اكتشاف سريعة إذا تم تثبيت Piper أو وضع نموذج بعد بدء التشغيل
        if not self.piper_bin:
            self.piper_bin = self._discover_piper_binary()
        if not self.model_path:
            self.model_path = self._discover_arabic_model()

        if not (self.piper_bin and self.model_path):
            return None

        rate = (prosody or {}).get("rate", 1.02)
        length_scale = self._rate_to_length_scale(rate)
        cache_key = hashlib.sha256(
            f"{self.model_path}|{length_scale}|{spoken}".encode("utf-8")
        ).hexdigest()[:20]
        out_wav = self.cache_dir / f"piper_{cache_key}.wav"

        if out_wav.exists() and out_wav.stat().st_size > 44:
            return out_wav

        cmd = [
            self.piper_bin,
            "--model",
            self.model_path,
            "--length-scale",
            str(length_scale),
            "--output_file",
            str(out_wav),
        ]
        cfg_path = Path(f"{self.model_path}.json")
        if cfg_path.exists():
            cmd.extend(["--config", str(cfg_path)])

        try:
            proc = subprocess.run(
                cmd,
                input=spoken.encode("utf-8"),
                capture_output=True,
                timeout=25,
            )
            if proc.returncode == 0 and out_wav.exists() and out_wav.stat().st_size > 44:
                return out_wav
        except Exception:
            pass

        out_wav.unlink(missing_ok=True)
        return None
