import tempfile
import unittest
from pathlib import Path
from unittest import mock

from omega_company import SoftwareCompanyOrchestrator
from omega_piper_tts import PiperNeuralVoiceEngine


class TestPiperOfflineNeuralVoice(unittest.TestCase):
    def test_01_piper_synthesis_and_cache(self):
        with tempfile.TemporaryDirectory() as tmp:
            root = Path(tmp)
            fake_bin = root / "piper.exe"
            fake_model = root / "ar_JO-kareem-medium.onnx"
            fake_bin.write_text("mock-bin", encoding="utf-8")
            fake_model.write_text("mock-onnx", encoding="utf-8")

            engine = PiperNeuralVoiceEngine(cache_dir=root / "cache")
            engine.piper_bin = str(fake_bin)
            engine.model_path = str(fake_model)

            def _fake_run(cmd, input=None, capture_output=True, timeout=25):
                out_idx = cmd.index("--output_file") + 1
                out_p = Path(cmd[out_idx])
                out_p.write_bytes(b"RIFF" + b"\x00" * 128)
                return mock.Mock(returncode=0)

            with mock.patch("omega_piper_tts.subprocess.run", side_effect=_fake_run) as run_mock:
                wav1 = engine.synthesize_wav("أهلاً بك يا هندسة في جينيسيس", {"rate": 1.05})
                wav2 = engine.synthesize_wav("أهلاً بك يا هندسة في جينيسيس", {"rate": 1.05})
                self.assertIsNotNone(wav1)
                self.assertTrue(wav1.exists())
                self.assertEqual(wav1, wav2)
                # يجب استدعاء subprocess مرة واحدة فقط بفضل التخزين المؤقت (Cache)
                self.assertEqual(run_mock.call_count, 1)

    def test_02_converse_attaches_audio_url_when_ready(self):
        with tempfile.TemporaryDirectory() as tmp:
            orch = SoftwareCompanyOrchestrator(
                base_dir=Path(tmp) / "studio",
                ollama_url="http://127.0.0.1:19999",
                auto_start_worker=False,
            )
            fake_wav = orch.cognitive_voice.piper_tts.cache_dir / "piper_test123.wav"
            fake_wav.write_bytes(b"RIFF" + b"\x00" * 128)

            with mock.patch.object(
                orch.cognitive_voice.piper_tts, "synthesize_wav", return_value=fake_wav
            ):
                res = orch.cognitive_voice.converse("السلام عليكم يا جينيسيس")
                self.assertEqual(res["audio_url"], "/api/voice/audio/piper_test123.wav")
                self.assertIn("neural_tts", res)


if __name__ == "__main__":
