def make_handler(orchestrator: SoftwareCompanyOrchestrator, ollama_url: str = DEFAULT_OLLAMA_URL):
    class StudioHandler(BaseHTTPRequestHandler):
        def _send_json(self, payload, status=200):
            body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
            self.send_response(status)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def _send_html(self, html_str: str, status=200):
            body = html_str.encode("utf-8")
            self.send_response(status)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            parsed = urlparse(self.path)
            path = parsed.path

            if path == "/":
                self._send_html(HTML_UI)
                return

            if path == "/api/status":
                st = PolyglotToolchain.probe_environment(ollama_url)
                st["governor"] = orchestrator.governor.get_memory_stats()
                st["voice"] = LocalOfflineVoiceBridge.capabilities()
                self._send_json(st)
                return

            if path == "/api/ecosystems":
                self._send_json(ECOSYSTEM_CATALOG)
                return

            if path == "/api/templates":
                self._send_json(PROJECT_TEMPLATES)
                return

            if path == "/api/analytics":
                qs = parse_qs(parsed.query)
                q = (qs.get("q") or [""])[0]
                self._send_json(orchestrator.get_analytics_and_vault(q))
                return

            if path == "/api/watches":
                self._send_json(orchestrator.watcher.list_watches())
                return

            if path == "/api/projects":
                self._send_json(orchestrator.list_projects())
                return

            m_proj = re.match(r"^/api/projects/(\d+)$", path)
            if m_proj:
                proj = orchestrator.get_project(int(m_proj.group(1)))
                if not proj:
                    self._send_json({"error": "not_found"}, 404)
                else:
                    self._send_json(proj)
                return

            m_sb_st = re.match(r"^/api/projects/(\d+)/sandbox/status$", path)
            if m_sb_st:
                self._send_json(orchestrator.get_project_sandbox_status(int(m_sb_st.group(1))))
                return

            m_diag = re.match(r"^/api/projects/(\d+)/diagrams$", path)
            if m_diag:
                proj = orchestrator.get_project(int(m_diag.group(1)))
                html_str = (proj or {}).get("files", {}).get("architecture_diagrams.html")
                if not html_str:
                    self._send_json({"error": "diagrams_not_available"}, 404)
                else:
                    self._send_html(html_str)
                return

            m_rep_html = re.match(r"^/api/projects/(\d+)/report/html$", path)
            if m_rep_html:
                html_doc = orchestrator.get_project_html_report(int(m_rep_html.group(1)))
                if not html_doc:
                    self._send_json({"error": "not_found"}, 404)
                else:
                    self._send_html(html_doc)
                return

            m_prev = re.match(r"^/api/projects/(\d+)/preview$", path)
            if m_prev:
                proj = orchestrator.get_project(int(m_prev.group(1)))
                html_str = (proj or {}).get("files", {}).get("index.html")
                if not html_str:
                    self._send_json({"error": "preview_not_available"}, 404)
                else:
                    self._send_html(html_str)
                return

            m_swg = re.match(r"^/api/projects/(\d+)/swagger$", path)
            if m_swg:
                proj = orchestrator.get_project(int(m_swg.group(1)))
                html_str = (proj or {}).get("files", {}).get("swagger_ui.html")
                if not html_str:
                    self._send_json({"error": "swagger_not_available"}, 404)
                else:
                    self._send_html(html_str)
                return

            m_dl = re.match(r"^/api/projects/(\d+)/download$", path)
            if m_dl:
                proj = orchestrator.get_project(int(m_dl.group(1)))
                zip_file = Path(proj["zip_path"]) if proj and proj.get("zip_path") else None
                if not zip_file or not zip_file.exists():
                    self._send_json({"error": "zip_not_ready"}, 404)
                    return
                data = zip_file.read_bytes()
                self.send_response(200)
                self.send_header("Content-Type", "application/zip")
                self.send_header("Content-Disposition", f'attachment; filename="{zip_file.name}"')
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)
                return

            self._send_json({"error": "not_found"}, 404)

        def do_POST(self):
            path = urlparse(self.path).path
            length = int(self.headers.get("Content-Length", "0"))
            raw_body = self.rfile.read(length).decode("utf-8") if length else "{}"
            try:
                data = json.loads(raw_body or "{}")
            except json.JSONDecodeError:
                self._send_json({"error": "invalid_json"}, 400)
                return

            if path == "/api/voice/command":
                res = orchestrator.voice_router.execute_voice_command(
                    transcript=data.get("transcript", ""),
                    active_project_id=data.get("active_project_id"),
                )
                self._send_json(res, 200)
                return

            if path == "/api/voice/transcribe":
                try:
                    tr = LocalOfflineVoiceBridge.transcribe_wav_base64(
                        audio_base64=data.get("audio_base64", ""),
                        model_dir=data.get("model_dir", ""),
                    )
                    self._send_json(tr, 200)
                except Exception as exc:
                    self._send_json({"error": str(exc)}, 400)
                return

            if path == "/api/projects":
                pid = orchestrator.submit_project(data.get("title", ""), data.get("prompt", ""), data.get("overrides"))
                self._send_json({"id": pid, "status": "queued"}, 201)
                return

            if path == "/api/projects/upload":
                try:
                    pid = orchestrator.submit_uploaded_zip(
                        title=data.get("title", ""),
                        prompt=data.get("prompt", ""),
                        filename=data.get("filename", "project.zip"),
                        zip_base64=data.get("zip_base64", ""),
                        model_overrides=data.get("overrides"),
                    )
                    self._send_json({"id": pid, "status": "queued", "mode": "audit"}, 201)
                except ValueError as exc:
                    self._send_json({"error": str(exc)}, 400)
                return

            m_sb_start = re.match(r"^/api/projects/(\d+)/sandbox/start$", path)
            if m_sb_start:
                try:
                    st = orchestrator.start_project_sandbox(int(m_sb_start.group(1)))
                    self._send_json(st, 200)
                except ValueError as exc:
                    self._send_json({"error": str(exc)}, 400)
                return

            m_sb_stop = re.match(r"^/api/projects/(\d+)/sandbox/stop$", path)
            if m_sb_stop:
                st = orchestrator.stop_project_sandbox(int(m_sb_stop.group(1)))
                self._send_json(st, 200)
                return

            if path == "/api/watches":
                try:
                    wid = orchestrator.watcher.add_watch(
                        folder_path=data.get("folder_path", ""),
                        goal=data.get("goal", ""),
                        interval_sec=data.get("interval_sec", 15),
                    )
                    self._send_json({"id": wid}, 201)
                except ValueError as exc:
                    self._send_json({"error": str(exc)}, 400)
                return

            if path == "/api/watches/scan":
                triggered = orchestrator.watcher.scan_once(force=True)
                self._send_json({"triggered": triggered}, 200)
                return

            m_wtog = re.match(r"^/api/watches/(\d+)/toggle$", path)
            if m_wtog:
                updated = orchestrator.watcher.toggle_watch(int(m_wtog.group(1)))
                self._send_json(updated or {"error": "not_found"}, 200 if updated else 404)
                return

            if path == "/api/vault":
                try:
                    vid = orchestrator.add_vault_wisdom(
                        data.get("domain", ""), data.get("pattern", ""), data.get("wisdom", "")
                    )
                    self._send_json({"id": vid}, 201)
                except ValueError as exc:
                    self._send_json({"error": str(exc)}, 400)
                return

            m_exp_local = re.match(r"^/api/projects/(\d+)/export/local$", path)
            if m_exp_local:
                try:
                    res = orchestrator.export_project_local(int(m_exp_local.group(1)), data.get("destination", ""))
                    self._send_json(res, 200)
                except ValueError as exc:
                    self._send_json({"error": str(exc)}, 400)
                return

            m_exp_git = re.match(r"^/api/projects/(\d+)/export/git$", path)
            if m_exp_git:
                try:
                    res = orchestrator.export_project_git(
                        int(m_exp_git.group(1)),
                        repo_url=data.get("repo_url", ""),
                        branch=data.get("branch", "main"),
                        commit_message=data.get("commit_message", ""),
                        token=data.get("token", ""),
                    )
                    self._send_json(res, 200)
                except ValueError as exc:
                    self._send_json({"error": str(exc)}, 400)
                return

            m_retry = re.match(r"^/api/projects/(\d+)/retry$", path)
            if m_retry:
                orchestrator.retry_project(int(m_retry.group(1)))
                self._send_json({"status": "queued"})
                return

            self._send_json({"error": "not_found"}, 404)

        def do_DELETE(self):
            path = urlparse(self.path).path
            m_del = re.match(r"^/api/projects/(\d+)$", path)
            if m_del:
                ok = orchestrator.delete_project(int(m_del.group(1)))
                self._send_json({"deleted": ok}, 200 if ok else 404)
                return

            m_wdel = re.match(r"^/api/watches/(\d+)$", path)
            if m_wdel:
                ok = orchestrator.watcher.delete_watch(int(m_wdel.group(1)))
                self._send_json({"deleted": ok}, 200 if ok else 404)
                return

            m_vdel = re.match(r"^/api/vault/(\d+)$", path)
            if m_vdel:
                ok = orchestrator.delete_vault_wisdom(int(m_vdel.group(1)))
                self._send_json({"deleted": ok}, 200 if ok else 404)
                return

            self._send_json({"error": "not_found"}, 404)

        def log_message(self, format, *args):
            return

    return StudioHandler


def main():
    port = int(sys.argv[1]) if len(sys.argv) > 1 else 8787
    server = ThreadingHTTPServer(("127.0.0.1", port), make_handler(STUDIO))
