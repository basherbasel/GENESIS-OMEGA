                       SET status = ?, language = ?, score = ?, tests_run = ?,
                           red_team_status = ?, workspace_path = ?, zip_path = ?,
                           report_md = ?, finished_at = ?
                       WHERE id = ?""",
                    (
                        final_status,
                        result["language"],
                        result["score"],
                        result["tests_run"],
                        result["red_team_status"],
                        result["workspace"],
                        result["zip_path"],
                        result["report"],
                        finished,
                        pid,
                    ),
                )

            full_proj = self.get_project(pid)
            if full_proj:
                HtmlAuditReportGenerator.generate_report(full_proj, workspace=ws)
                self._append_log(pid, "🖨️ تم توليد تقرير التدقيق الرسمي القابل للطباعة كـ PDF (OMEGA_AUDIT_REPORT.html).")

        except Exception as exc:
            self._append_log(pid, f"❌ خطأ حرج أثناء التنفيذ: {exc}")
            finished = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            with self._lock, self._connect() as conn:
                conn.execute(
                    "UPDATE projects SET status = 'failed', finished_at = ? WHERE id = ?",
                    (finished, pid),
                )
        return True

    def _worker_loop(self):
        while not self._stop_event.is_set():
            did_work = self.process_next_job()
            if not did_work:
                stats = self.governor.get_memory_stats()
                time.sleep(stats.get("watch_poll_sec", 2.0))
