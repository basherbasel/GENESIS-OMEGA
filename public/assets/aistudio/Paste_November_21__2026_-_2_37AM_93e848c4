function pickBestArabicVoice() {
  const voices = window.speechSynthesis.getVoices() || [];
  return (
    voices.find(v => /ar/i.test(v.lang) && /(Natural|Neural|Salma|Shakir|Hoda|Naayf)/i.test(v.name)) ||
    voices.find(v => /ar-(EG|SA|AE)/i.test(v.lang)) ||
    voices.find(v => /ar/i.test(v.lang)) ||
    null
  );
}

function speakArabic(text, prosody = {rate: 1.02, pitch: 1.0}) {
  if (!document.getElementById('ttsToggle')?.checked) return;
  if (!('speechSynthesis' in window) || !text) return;
  try {
    window.speechSynthesis.cancel();
    const cleanText = text.replace(/[*#_`~]/g, '').trim();
    const sentences = cleanText.split(/(?<=[.،؟!])\s+/).filter(Boolean);
    const voice = pickBestArabicVoice();

    sentences.forEach((sentence) => {
      const utt = new SpeechSynthesisUtterance(sentence);
      if (voice) utt.voice = voice;
      utt.lang = voice?.lang || 'ar-EG';
      utt.rate = prosody.rate || 1.02;
      utt.pitch = prosody.pitch || 1.0;
      window.speechSynthesis.speak(utt);
    });
  } catch (e) {}
}
