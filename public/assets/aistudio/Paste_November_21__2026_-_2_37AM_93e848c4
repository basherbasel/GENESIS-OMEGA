<script>
let selectedId = null;
let activeTab = 'logs';
let workMode = 'new';
let selectedZipFile = null;
let templatesCache = [];
let recognition = null;
let isListening = false;
const ROLES = ['architect','strategist','builder_alpha','builder_beta','red_team','synthesizer_healer'];

function escHtml(s) {
  return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function speakArabic(text) {
  if (!document.getElementById('ttsToggle')?.checked) return;
  if (!('speechSynthesis' in window) || !text) return;
  try {
    window.speechSynthesis.cancel();
    const utt = new SpeechSynthesisUtterance(text);
    utt.lang = 'ar-EG';
    utt.rate = 1.05;
    window.speechSynthesis.speak(utt);
  } catch (e) {}
}

function toggleVoiceRecognition() {
  const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SpeechRec) {
    alert('المتصفح الحالي لا يدعم التعرف الصوتي المباشر، يمكنك كتابة أمرك في شريط الأوامر بالأعلى.');
    return;
  }
  const btn = document.getElementById('micBtn');
  if (isListening && recognition) {
    document.getElementById('wakeLoopToggle').checked = false;
    recognition.stop();
    return;
  }
  recognition = new SpeechRec();
  recognition.lang = 'ar-EG';
  recognition.interimResults = false;
  recognition.maxAlternatives = 1;

  recognition.onstart = () => {
    isListening = true;
    btn.classList.add('listening');
    btn.textContent = '🔴 جاري الاستماع...';
  };
  recognition.onresult = async (event) => {
    const transcript = event.results[0][0].transcript;
    const wakeMode = document.getElementById('wakeLoopToggle')?.checked;
    if (wakeMode && !/(جينيسيس|جنيسيس|أوميجا|اوميجا|genesis|omega)/i.test(transcript)) {
      return;
    }
    document.getElementById('voiceCmdInput').value = transcript;
    await sendVoiceCommand();
  };
  recognition.onerror = () => {
    isListening = false;
    btn.classList.remove('listening');
    btn.textContent = '🎙️ تحدث بأمرك';
  };
  recognition.onend = () => {
    isListening = false;
    btn.classList.remove('listening');
    btn.textContent = '🎙️ تحدث بأمرك';
    if (document.getElementById('wakeLoopToggle')?.checked) {
      setTimeout(() => { try { recognition.start(); } catch(e) {} }, 400);
    }
  };
  recognition.start();
}

async function sendVoiceCommand() {
  const inp = document.getElementById('voiceCmdInput');
  const transcript = inp.value.trim();
  if (!transcript) return;
  const replyBox = document.getElementById('voiceReplyBox');
  replyBox.style.display = 'block';
  replyBox.textContent = '⏳ جاري تحليل وتنفيذ الأمر الصوتي...';

  const res = await fetch('/api/voice/command', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({transcript, active_project_id: selectedId})
  });
  const data = await res.json();
  replyBox.textContent = `🤖 ${data.spoken_reply || ''}`;
  speakArabic(data.spoken_reply || '');

  const cmd = data.ui_command;
  if (cmd) {
    if (cmd.action === 'switch_view') switchTopView(cmd.view);
    if (cmd.action === 'select_project' && cmd.project_id) {
      switchTopView('studio');
      selectedId = cmd.project_id;
      if (cmd.tab) activeTab = cmd.tab;
      if (cmd.open_url) window.open(cmd.open_url, '_blank');
    }
  }
  await refreshAll();
}

function switchTopView(view) {
  document.getElementById('viewStudio').style.display = view === 'studio' ? 'grid' : 'none';
  document.getElementById('viewWatch').style.display = view === 'watch' ? 'block' : 'none';
  document.getElementById('viewVault').style.display = view === 'vault' ? 'block' : 'none';
  document.getElementById('navStudio').classList.toggle('active', view === 'studio');
  document.getElementById('navWatch').classList.toggle('active', view === 'watch');
  document.getElementById('navVault').classList.toggle('active', view === 'vault');
  if (view === 'watch') loadWatches();
  if (view === 'vault') loadAnalytics();
}

async function startSandbox(id) {
  const res = await fetch(`/api/projects/${id}/sandbox/start`, {method: 'POST'});
  const data = await res.json();
  if (!res.ok) return alert(data.error || 'تعذر تشغيل البيئة المعزولة');
  activeTab = 'sandbox';
  await refreshAll();
}

async function stopSandbox(id) {
  await fetch(`/api/projects/${id}/sandbox/stop`, {method: 'POST'});
  await refreshAll();
}

async function triggerBenchmark(id) {
  const res = await fetch(`/api/projects/${id}/benchmark`, {method: 'POST', headers: {'Content-Type': 'application/json'}, body: '{}'});
  if (!res.ok) return alert('تعذر تنفيذ اختبار الأداء');
  activeTab = 'benchmark';
  await refreshAll();
}

async function loadWatches() {
  const res = await fetch('/api/watches');
  const items = await res.json();
  const box = document.getElementById('watchList');
  if (!items.length) {
    box.innerHTML = '<p style="color:var(--muted)">لا توجد مجلدات مراقبة حالياً.</p>';
    return;
  }
  box.innerHTML = items.map(w => `
    <div class="list-card">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
        <strong style="direction:ltr;font-family:Consolas,monospace;color:var(--cyan)">${escHtml(w.folder_path)}</strong>
        <div style="display:flex;gap:6px;align-items:center">
          <span class="status ${w.enabled ? 'st-verified' : 'st-queued'}">${w.enabled ? 'نشط' : 'متوقف'}</span>
          <button class="secondary" onclick="toggleWatch(${w.id})">${w.enabled ? 'إيقاف مؤقت' : 'تفعيل'}</button>
          <button class="danger" onclick="deleteWatch(${w.id})">حذف</button>
        </div>
      </div>
      <div style="font-size:0.83rem;margin-top:6px">${escHtml(w.goal)}</div>
      <div style="font-size:0.77rem;color:var(--muted);margin-top:6px">
        الفترة: كل ${w.interval_sec} ثانية | الملفات: ${w.files_count} | آخر فحص: ${w.last_checked_at || '-'}
      </div>
    </div>
  `).join('');
}

async function addWatchFolder() {
  const folder_path = document.getElementById('wFolderPath').value;
  const interval_sec = parseInt(document.getElementById('wInterval').value || '15', 10);
  const goal = document.getElementById('wGoal').value;
  const msgEl = document.getElementById('watchMsg');
  const res = await fetch('/api/watches', {
    method: 'POST', headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({folder_path, interval_sec, goal})
  });
  const data = await res.json();
  if (!res.ok) {
    msgEl.innerHTML = `<span style="color:var(--err)">❌ ${escHtml(data.error)}</span>`;
    return;
  }
  msgEl.innerHTML = '<span style="color:var(--ok)">✅ تم تسجيل المجلد وتعيين البصمة الأساسية بنجاح.</span>';
  document.getElementById('wFolderPath').value = '';
  await loadWatches();
}

async function toggleWatch(id) { await fetch(`/api/watches/${id}/toggle`, {method: 'POST'}); await loadWatches(); }
async function deleteWatch(id) { await fetch(`/api/watches/${id}`, {method: 'DELETE'}); await loadWatches(); }
async function triggerWatchScanNow() {
  const res = await fetch('/api/watches/scan', {method: 'POST'});
  const data = await res.json();
  alert(`اكتمل الفحص الفوري: تم إطلاق ${(data.triggered || []).length} مهمة تدقيق.`);
  await loadWatches();
  await refreshAll();
}

function openExportModal() {
  if (!selectedId) return;
  document.getElementById('exportStatus').innerHTML = '';
  document.getElementById('exportModal').style.display = 'flex';
}
function closeExportModal() { document.getElementById('exportModal').style.display = 'none'; }
function setExportTab(tab) {
  document.getElementById('expTabLocal').classList.toggle('active', tab === 'local');
  document.getElementById('expTabGit').classList.toggle('active', tab === 'git');
  document.getElementById('expLocalPane').style.display = tab === 'local' ? 'block' : 'none';
  document.getElementById('expGitPane').style.display = tab === 'git' ? 'block' : 'none';
}

async function runLocalExport() {
  const destination = document.getElementById('expLocalPath').value;
  const st = document.getElementById('exportStatus');
  st.innerHTML = '<span style="color:var(--cyan)">جاري نسخ الملفات...</span>';
  const res = await fetch(`/api/projects/${selectedId}/export/local`, {
    method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({destination})
  });
  const data = await res.json();
  st.innerHTML = res.ok ? `<span style="color:var(--ok)">✅ ${escHtml(data.message)}</span>` : `<span style="color:var(--err)">❌ ${escHtml(data.error)}</span>`;
