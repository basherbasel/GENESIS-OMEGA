        log(f"🧠 توزيع النماذج: {json.dumps(self.routing, ensure_ascii=False)}")

        work_arena = self.arenas_dir / "audit_work"
        if work_arena.exists():
            shutil.rmtree(work_arena)
        shutil.copytree(source_dir, work_arena)

        log("🌐 [1/6] جرد ملفات المشروع وإجراء الفحص الأمني الساكن الأولي...")
        initial_sec = PolyglotToolchain.static_security_scan(work_arena)
        code_files = [
            f.relative_to(work_arena).as_posix()
            for f in sorted(work_arena.rglob("*"))
            if f.is_file() and f.suffix in PolyglotToolchain.CODE_EXTENSIONS
        ]
        log(f"   📂 الملفات البرمجية ({len(code_files)}): {code_files[:12]}")
        log(f"   🚨 الملاحظات الأمنية الأولية: {len(initial_sec)}")

        log("🧠 [2/6] المحلل الأمني يحدد الثغرات ونقاط الضعف المطلوب ترقيعها...")
        constraints = strip_think_tags(
            self._ask(
