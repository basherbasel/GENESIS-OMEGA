        attack_code = (m_atk.group(1).strip() if m_atk else strip_think_tags(attack_raw)) + "\n"
        valid_atk, atk_reason = validate_red_team_script(attack_code, modules)

        red_status = "unavailable"
        red_report = f"Red-Team unavailable: {atk_reason}"
        if valid_atk:
            (work_arena / "red_team_attack.py").write_text(attack_code, encoding="utf-8")
            try:
                r_proc = subprocess.run(
                    [sys.executable, "red_team_attack.py"],
