class LocalOfflineVoiceBridge:
    """جسر اختياري للتعرف الصوتي المحلي بدون إنترنت عبر Vosk أو faster-whisper عند توفرهما."""

    @staticmethod
    def capabilities() -> dict:
        has_vosk = importlib.util.find_spec("vosk") is not None
        has_whisper = importlib.util.find_spec("faster_whisper") is not None
        return {
            "browser_speech_api": True,
            "offline_vosk": has_vosk,
            "offline_faster_whisper": has_whisper,
        }

    @staticmethod
    def transcribe_wav_base64(audio_base64: str, model_dir: str = "") -> dict:
        raw = base64.b64decode(audio_base64)
        if importlib.util.find_spec("vosk") is not None and model_dir and Path(model_dir).exists():
            from vosk import KaldiRecognizer, Model

            with wave.open(io.BytesIO(raw), "rb") as wf:
                model = Model(model_dir)
                rec = KaldiRecognizer(model, wf.getframerate())
                while True:
                    chunk = wf.readframes(4000)
                    if not chunk:
                        break
                    rec.AcceptWaveform(chunk)
                res = json.loads(rec.FinalResult())
                return {"engine": "vosk", "text": res.get("text", "").strip()}

        if importlib.util.find_spec("faster_whisper") is not None:
            from faster_whisper import WhisperModel

            with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as tf:
                tf.write(raw)
                tmp_path = Path(tf.name)
            try:
                model = WhisperModel("tiny", device="cpu", compute_type="int8")
                segments, _ = model.transcribe(str(tmp_path), language="ar")
                txt = " ".join(s.text.strip() for s in segments).strip()
                return {"engine": "faster-whisper", "text": txt}
            finally:
                tmp_path.unlink(missing_ok=True)

        raise RuntimeError("يرجى استخدام الميكروفون المدمج في المتصفح (Web Speech API) أو تثبيت vosk / faster-whisper محلياً.")

